<Window x:Class="Halaqa.Desktop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:authVm="clr-namespace:Halaqa.Desktop.Features.Auth.Presentation.ViewModels"
        xmlns:authViews="clr-namespace:Halaqa.Desktop.Features.Auth.Presentation.Views"
        xmlns:local="clr-namespace:Halaqa.Desktop.Presentation"
        xmlns:halaqasVm="clr-namespace:Halaqa.Desktop.Features.Halaqas.Presentation.ViewModels"
        xmlns:halaqasViews="clr-namespace:Halaqa.Desktop.Features.Halaqas.Presentation.Views"
        xmlns:membershipsVm="clr-namespace:Halaqa.Desktop.Features.Memberships.Presentation.ViewModels"
        xmlns:membershipsViews="clr-namespace:Halaqa.Desktop.Features.Memberships.Presentation.Views"
        xmlns:profileVm="clr-namespace:Halaqa.Desktop.Features.Profile.Presentation.ViewModels"
        xmlns:profileViews="clr-namespace:Halaqa.Desktop.Features.Profile.Presentation.Views"
        xmlns:registrationsVm="clr-namespace:Halaqa.Desktop.Features.Registrations.Presentation.ViewModels"
        xmlns:registrationsViews="clr-namespace:Halaqa.Desktop.Features.Registrations.Presentation.Views"
        xmlns:teacherDocumentsVm="clr-namespace:Halaqa.Desktop.Features.TeacherDocuments.Presentation.ViewModels"
        xmlns:teacherDocumentsViews="clr-namespace:Halaqa.Desktop.Features.TeacherDocuments.Presentation.Views"
        xmlns:sessionsVm="clr-namespace:Halaqa.Desktop.Features.Sessions.Presentation.ViewModels"
        xmlns:sessionsViews="clr-namespace:Halaqa.Desktop.Features.Sessions.Presentation.Views"
        Title="حلقة القرآن" Height="720" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type authVm:LoginViewModel}">
            <authViews:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:StudentRegistrationViewModel}">
            <authViews:StudentRegistrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:TeacherRegistrationViewModel}">
            <authViews:TeacherRegistrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ForgotPasswordViewModel}">
            <authViews:ForgotPasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ResetPasswordViewModel}">
            <authViews:ResetPasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ChangePasswordViewModel}">
            <authViews:ChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DashboardViewModel}">
            <local:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:GeneralProfileViewModel}">
            <profileViews:GeneralProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:StudentProfileViewModel}">
            <profileViews:StudentProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:TeacherProfileViewModel}">
            <profileViews:TeacherProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type teacherDocumentsVm:TeacherDocumentsViewModel}">
            <teacherDocumentsViews:TeacherDocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type halaqasVm:HalaqasViewModel}">
            <halaqasViews:HalaqasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type membershipsVm:HalaqaMembershipsViewModel}">
            <membershipsViews:HalaqaMembershipsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:HalaqaRegistrationRequestsViewModel}">
            <registrationsViews:HalaqaRegistrationRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:StudentTeacherDirectoryViewModel}">
            <registrationsViews:StudentTeacherDirectoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:StudentRegistrationRequestsViewModel}">
            <registrationsViews:StudentRegistrationRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sessionsVm:LiveSessionViewModel}">
            <sessionsViews:LiveSessionView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource AppSurfaceBrush}" Padding="28,16" BorderBrush="#14000000" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="حلقة القرآن" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="منصة للحلقات التعليمية المباشرة" Style="{StaticResource BodyMuted}" Margin="12,4,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="متصل عبر API آمن" Foreground="{StaticResource AppInfoBrush}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
