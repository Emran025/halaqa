<Window x:Class="Halaqa.Desktop.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:authVm="clr-namespace:Halaqa.Desktop.Features.Auth.Presentation.ViewModels"
        xmlns:followUpVm="clr-namespace:Halaqa.Desktop.Features.FollowUp.Presentation.ViewModels"
        xmlns:followUpViews="clr-namespace:Halaqa.Desktop.Features.FollowUp.Presentation.Views"
        xmlns:quranVm="clr-namespace:Halaqa.Desktop.Features.Quran.Presentation.ViewModels"
        xmlns:quranViews="clr-namespace:Halaqa.Desktop.Features.Quran.Presentation.Views"
        xmlns:notificationsVm="clr-namespace:Halaqa.Desktop.Features.Notifications.Presentation.ViewModels"
        xmlns:notificationsViews="clr-namespace:Halaqa.Desktop.Features.Notifications.Presentation.Views"
        xmlns:authViews="clr-namespace:Halaqa.Desktop.Features.Auth.Presentation.Views"
        xmlns:local="clr-namespace:Halaqa.Desktop.Presentation"
        xmlns:halaqasVm="clr-namespace:Halaqa.Desktop.Features.Halaqas.Presentation.ViewModels"
        xmlns:halaqasViews="clr-namespace:Halaqa.Desktop.Features.Halaqas.Presentation.Views"
        xmlns:membershipsVm="clr-namespace:Halaqa.Desktop.Features.Memberships.Presentation.ViewModels"
        xmlns:membershipsViews="clr-namespace:Halaqa.Desktop.Features.Memberships.Presentation.Views"
        xmlns:profileVm="clr-namespace:Halaqa.Desktop.Features.Profile.Presentation.ViewModels"
        xmlns:profileViews="clr-namespace:Halaqa.Desktop.Features.Profile.Presentation.Views"
        xmlns:registrationsVm="clr-namespace:Halaqa.Desktop.Features.Registrations.Presentation.ViewModels"
        xmlns:registrationsViews="clr-namespace:Halaqa.Desktop.Features.Registrations.Presentation.Views"
        xmlns:teacherDocumentsVm="clr-namespace:Halaqa.Desktop.Features.TeacherDocuments.Presentation.ViewModels"
        xmlns:teacherDocumentsViews="clr-namespace:Halaqa.Desktop.Features.TeacherDocuments.Presentation.Views"
        xmlns:sessionsVm="clr-namespace:Halaqa.Desktop.Features.Sessions.Presentation.ViewModels"
        xmlns:sessionsViews="clr-namespace:Halaqa.Desktop.Features.Sessions.Presentation.Views"
        xmlns:mistakesVm="clr-namespace:Halaqa.Desktop.Features.Mistakes.Presentation.ViewModels"
        xmlns:mistakesViews="clr-namespace:Halaqa.Desktop.Features.Mistakes.Presentation.Views"
        xmlns:evaluationsVm="clr-namespace:Halaqa.Desktop.Features.Evaluations.Presentation.ViewModels"
        xmlns:evaluationsViews="clr-namespace:Halaqa.Desktop.Features.Evaluations.Presentation.Views"
        xmlns:notesVm="clr-namespace:Halaqa.Desktop.Features.Notes.Presentation.ViewModels"
        xmlns:notesViews="clr-namespace:Halaqa.Desktop.Features.Notes.Presentation.Views"
        xmlns:progressVm="clr-namespace:Halaqa.Desktop.Features.Progress.Presentation.ViewModels"
        xmlns:progressViews="clr-namespace:Halaqa.Desktop.Features.Progress.Presentation.Views"
        xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
        Title="حلقة القرآن" Icon="/Assets/Brand/halaqa-mark.ico" Height="780" Width="1180" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type authVm:LoginViewModel}">
            <authViews:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:StudentRegistrationViewModel}">
            <authViews:StudentRegistrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:TeacherRegistrationViewModel}">
            <authViews:TeacherRegistrationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ForgotPasswordViewModel}">
            <authViews:ForgotPasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ResetPasswordViewModel}">
            <authViews:ResetPasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type authVm:ChangePasswordViewModel}">
            <authViews:ChangePasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sessionsVm:SessionsViewModel}">
            <sessionsViews:SessionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sessionsVm:SessionTasksViewModel}">
            <sessionsViews:SessionTasksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type mistakesVm:MistakeReportViewModel}">
            <mistakesViews:MistakeReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type evaluationsVm:TaskEvaluationViewModel}">
            <evaluationsViews:TaskEvaluationView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type notesVm:TaskNotesViewModel}">
            <notesViews:TaskNotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type progressVm:StudentProgressViewModel}">
            <progressViews:StudentProgressView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:DashboardViewModel}">
            <local:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:GeneralProfileViewModel}">
            <profileViews:GeneralProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:StudentProfileViewModel}">
            <profileViews:StudentProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type profileVm:TeacherProfileViewModel}">
            <profileViews:TeacherProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type teacherDocumentsVm:TeacherDocumentsViewModel}">
            <teacherDocumentsViews:TeacherDocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type halaqasVm:HalaqasViewModel}">
            <halaqasViews:HalaqasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type membershipsVm:HalaqaMembershipsViewModel}">
            <membershipsViews:HalaqaMembershipsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:HalaqaRegistrationRequestsViewModel}">
            <registrationsViews:HalaqaRegistrationRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:StudentTeacherDirectoryViewModel}">
            <registrationsViews:StudentTeacherDirectoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:StudentRegistrationRequestsViewModel}">
            <registrationsViews:StudentRegistrationRequestsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type registrationsVm:TeacherApplicationInboxViewModel}">
            <registrationsViews:TeacherApplicationInboxView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type followUpVm:FollowUpViewModel}">
            <followUpViews:FollowUpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type followUpVm:ComprehensiveTrackingViewModel}">
            <followUpViews:ComprehensiveTrackingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type followUpVm:StudentsViewModel}">
            <followUpViews:StudentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type followUpVm:StudentRecitationProfileViewModel}">
            <followUpViews:StudentRecitationProfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type quranVm:QuranReaderViewModel}">
            <quranViews:QuranReaderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type notificationsVm:NotificationsViewModel}">
            <notificationsViews:NotificationsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type sessionsVm:LiveSessionViewModel}">
            <sessionsViews:LiveSessionView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#FF1B524A" Padding="24,12" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="4" Background="#24FFFFFF" BorderBrush="#3DFFFFFF" BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="/Assets/Brand/halaqa-mark.png" Stretch="Uniform" Margin="5" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="حلقة القرآن" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="منصة للحلقات التعليمية المباشرة" Foreground="#DCEDEAE6" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding ShowNotificationsCommand}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="الإشعارات"
                        Padding="8,6"
                        Background="#24FFFFFF"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        Foreground="White"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <controls:AppIcon Kind="BellOutline" Foreground="White" FontSize="16" />
                </Button>
                <Button DockPanel.Dock="Left"
                        Command="{Binding LogoutCommand}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="تسجيل الخروج"
                        Padding="8,6"
                        Background="#24FFFFFF"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        Foreground="White"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <controls:AppIcon Kind="Logout" Foreground="White" FontSize="16" />
                </Button>
                <Button DockPanel.Dock="Left"
                        Command="{Binding GoToLoginCommand}"
                        Visibility="{Binding CanGoToLogin, Converter={StaticResource BooleanToVisibilityConverter}}"
                        ToolTip="العودة لتسجيل الدخول"
                        Padding="12,6"
                        Background="#24FFFFFF"
                        BorderBrush="#3DFFFFFF"
                        BorderThickness="1"
                        Foreground="White"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Kind="Login" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="تسجيل الدخول" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>
