<UserControl x:Class="Halaqa.Desktop.Presentation.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="DashboardCard" TargetType="{x:Type Border}" BasedOn="{StaticResource AppCard}">
            <Setter Property="Width" Value="272" />
            <Setter Property="MinHeight" Value="200" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="DashboardCardButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AppQuietButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppCanvasBrush}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Welcome Header -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="{Binding UserName, StringFormat=مرحباً بك، {0}}" Style="{StaticResource DisplayTitle}" />
                    <TextBlock Text="{Binding RoleLabel, StringFormat=لوحة تحكم {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Cards Container -->
            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <!-- Teacher Cards -->
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsTeacher, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource DashboardCard}" Background="#0D1B524A" BorderBrush="#331B524A">
                        <StackPanel>
                            <controls:AppIcon Kind="CalendarCheckOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="المتابعة الشاملة للطلاب" Style="{StaticResource SectionTitle}" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,14,0,4" />
                            <TextBlock Text="متابعة الحفظ والمراجعة اليومية، وبدء جلسات التسميع المباشرة بالمصحف." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح المتابعة والتسميع" Command="{Binding OpenComprehensiveTrackingCommand}" Style="{StaticResource DashboardCardButton}" Background="{StaticResource AppPrimaryBrush}" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountGroupOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="إدارة الحلقات" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="أنشئ حلقة، راجع طلبات الانضمام، وأدر شؤون الحلقات والطلاب." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح إدارة الحلقات" Command="{Binding OpenHalaqasCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <!-- Students Tab Card -->
                    <Border Style="{StaticResource DashboardCard}" Background="#0D006064" BorderBrush="#22006064">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountMultipleOutline" Foreground="#FF00838F" FontSize="28" />
                            <TextBlock Text="قائمة الطلاب" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="تصفح جميع طلابك، افتح ملف كل طالب، وراجع سجل تسميعاته ونتائج تقييماته." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح قائمة الطلاب" Command="{Binding OpenStudentsCommand}" Style="{StaticResource DashboardCardButton}" Background="#FF006064" Foreground="White" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountMultipleCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="28" />
                            <TextBlock Text="طلبات الطلاب المتاحة" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع طلبات التسجيل العامة للمتقدمين واتخذ قرار القبول بعد المراجعة." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح صندوق الطلبات" Command="{Binding OpenTeacherApplicationsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="FileCertificateOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="الوثائق والمؤهلات" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="ارفع الشهادات والإجازات والمؤهلات الرسمية الخاصة بحساب المعلم." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الوثائق والمؤهلات" Command="{Binding OpenTeacherDocumentsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountEditOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="الملف الشخصي" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع البيانات المهنية والاتصال الرسمية وروايات الإجازة المعتمدة." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الملف المهني" Command="{Binding OpenProfileCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountBoxOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="البيانات العامة" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="حدّث الاسم ورقم الهاتف والبيانات الأساسية المرتبطة بالحساب." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح البيانات العامة" Command="{Binding OpenGeneralProfileCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="VideoOutline" Foreground="{StaticResource AppInfoBrush}" FontSize="28" />
                            <TextBlock Text="جلساتي" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="اعرض الجلسات الرسمية المتاحة لحسابك وحالتها ومهامها." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الجلسات" Command="{Binding OpenSessionsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="BookOpenPageVariantOutline" Foreground="{StaticResource AppWarningBrush}" FontSize="28" />
                            <TextBlock Text="قارئ المصحف" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="اقرأ صفحات المصحف محلياً بالخط العثماني المعتمد." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح قارئ المصحف" Command="{Binding OpenQuranReaderCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="BellOutline" Foreground="{StaticResource AppInfoBrush}" FontSize="28" />
                            <TextBlock Text="الإشعارات" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع الرسائل والتنبيهات الرسمية الواردة لحسابك." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الإشعارات" Command="{Binding OpenNotificationsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="LockReset" Foreground="{StaticResource AppWarningBrush}" FontSize="28" />
                            <TextBlock Text="أمان الحساب" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="غيّر كلمة المرور الحالية لحسابك بأمان." Style="{StaticResource BodyMuted}" />
                            <Button Content="تغيير كلمة المرور" Command="{Binding OpenPasswordChangeCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Student Cards -->
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsStudent, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountGroupOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="البحث عن معلم" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="تصفح المعلمين المتاحين وقدّم طلب انضمام إلى حلقات التحفيظ." Style="{StaticResource BodyMuted}" />
                            <Button Content="تصفح المعلمين" Command="{Binding OpenStudentTeacherDirectoryCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountMultipleCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="28" />
                            <TextBlock Text="طلبات التسجيل" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="تابع حالة طلبات التسجيل التي أرسلتها للمعلمين والحلقات." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح طلباتي" Command="{Binding OpenStudentRequestsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="CalendarCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="28" />
                            <TextBlock Text="خطة المتابعة والحضور" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع خطتك الرسمية وأوقات الحضور وسجل المتابعة اليومي." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح المتابعة" Command="{Binding OpenFollowUpCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="ChartLine" Foreground="{StaticResource AppSuccessBrush}" FontSize="28" />
                            <TextBlock Text="تقدمي وتقاريري" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="اعرض سجل إنجازك في الحفظ والمراجعة وتقارير الجلسات." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح سجل التقدم" Command="{Binding OpenProgressCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountEditOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="الملف الشخصي" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع مستوى الحفظ ومسار المراجعة والبيانات التعليمية للطالب." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الملف التعليمي" Command="{Binding OpenProfileCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="AccountBoxOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="28" />
                            <TextBlock Text="البيانات العامة" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="حدّث الاسم ورقم الهاتف والبيانات الأساسية للحساب." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح البيانات العامة" Command="{Binding OpenGeneralProfileCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="VideoOutline" Foreground="{StaticResource AppInfoBrush}" FontSize="28" />
                            <TextBlock Text="جلساتي" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="اعرض الجلسات المقررة وحالتها ومهام التسميع المرتبطة بها." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الجلسات" Command="{Binding OpenSessionsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="BookOpenPageVariantOutline" Foreground="{StaticResource AppWarningBrush}" FontSize="28" />
                            <TextBlock Text="قارئ المصحف" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="اقرأ صفحات المصحف محلياً بالرسم العثماني المعتمد." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح قارئ المصحف" Command="{Binding OpenQuranReaderCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="BellOutline" Foreground="{StaticResource AppInfoBrush}" FontSize="28" />
                            <TextBlock Text="الإشعارات" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="راجع الرسائل والتنبيهات الموجهة لحسابك." Style="{StaticResource BodyMuted}" />
                            <Button Content="فتح الإشعارات" Command="{Binding OpenNotificationsCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCard}">
                        <StackPanel>
                            <controls:AppIcon Kind="LockReset" Foreground="{StaticResource AppWarningBrush}" FontSize="28" />
                            <TextBlock Text="أمان الحساب" Style="{StaticResource SectionTitle}" Margin="0,14,0,4" />
                            <TextBlock Text="غيّر كلمة المرور الحالية لحسابك بأمان." Style="{StaticResource BodyMuted}" />
                            <Button Content="تغيير كلمة المرور" Command="{Binding OpenPasswordChangeCommand}" Style="{StaticResource DashboardCardButton}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
