<Application x:Class="Halaqa.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:QuranPageFontFamilyConverter x:Key="QuranPageFontFamilyConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Shared/Presentation/Themes/Colors.xaml" />
                <ResourceDictionary Source="Shared/Presentation/Themes/Typography.xaml" />
                <ResourceDictionary Source="Shared/Presentation/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
