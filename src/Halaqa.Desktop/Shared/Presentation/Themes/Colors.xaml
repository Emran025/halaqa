<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Productivity-inspired neutral surfaces with the Tag Alwaqar emerald and brass accent. -->
    <Color x:Key="AppCanvasColor">#FFF4F6F8</Color>
    <Color x:Key="AppSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="AppSurfaceMutedColor">#FFF0F3F5</Color>
    <Color x:Key="AppBorderColor">#FFD6DDE3</Color>
    <Color x:Key="AppInkColor">#FF1F2933</Color>
    <Color x:Key="AppMutedInkColor">#FF64707D</Color>
    <Color x:Key="AppPrimaryColor">#FF24675D</Color>
    <Color x:Key="AppPrimaryHoverColor">#FF1B524A</Color>
    <Color x:Key="AppPrimarySoftColor">#FFE1EFEC</Color>
    <Color x:Key="AppAccentColor">#FFDEAB4E</Color>
    <Color x:Key="AppAccentSoftColor">#FFFFF4DE</Color>
    <Color x:Key="AppSuccessColor">#FF147A4B</Color>
    <Color x:Key="AppSuccessSoftColor">#FFDFF6E9</Color>
    <Color x:Key="AppWarningColor">#FF9B6200</Color>
    <Color x:Key="AppWarningSoftColor">#FFFFF1CF</Color>
    <Color x:Key="AppErrorColor">#FFB42318</Color>
    <Color x:Key="AppErrorSoftColor">#FFFDE7E5</Color>
    <Color x:Key="AppInfoColor">#FF185ABD</Color>
    <Color x:Key="AppInfoSoftColor">#FFE8F1FC</Color>

    <SolidColorBrush x:Key="AppCanvasBrush" Color="{StaticResource AppCanvasColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="{StaticResource AppSurfaceMutedColor}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppInkBrush" Color="{StaticResource AppInkColor}" />
    <SolidColorBrush x:Key="AppMutedInkBrush" Color="{StaticResource AppMutedInkColor}" />
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="{StaticResource AppPrimaryColor}" />
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="{StaticResource AppPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="{StaticResource AppPrimarySoftColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="{StaticResource AppAccentSoftColor}" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="{StaticResource AppSuccessSoftColor}" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="{StaticResource AppWarningSoftColor}" />
    <SolidColorBrush x:Key="AppErrorBrush" Color="{StaticResource AppErrorColor}" />
    <SolidColorBrush x:Key="AppErrorSoftBrush" Color="{StaticResource AppErrorSoftColor}" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="{StaticResource AppInfoColor}" />
    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="{StaticResource AppInfoSoftColor}" />

    <SolidColorBrush x:Key="AppGlassBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppGlassStrongBrush" Color="#FCFAFCFC" />
    <SolidColorBrush x:Key="AppGlassBorderBrush" Color="#FFD6DDE3" />
    <LinearGradientBrush x:Key="AppHeroOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0113432" Offset="0" />
        <GradientStop Color="#E8143E47" Offset="0.56" />
        <GradientStop Color="#CC102630" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
