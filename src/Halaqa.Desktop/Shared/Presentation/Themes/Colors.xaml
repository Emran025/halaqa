<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Productivity-inspired neutral surfaces with the Tag Alwaqar emerald and brass accent. -->
    <SolidColorBrush x:Key="AppCanvasBrush" Color="#FFF5F7F9" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="#FFF0F3F5" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#FFC3CDD6" />
    <SolidColorBrush x:Key="AppInkBrush" Color="#FF111827" />
    <SolidColorBrush x:Key="AppMutedInkBrush" Color="#FF26313B" />
    <SolidColorBrush x:Key="AppPrimaryBrush" Color="#FF24675D" />
    <SolidColorBrush x:Key="AppPrimaryHoverBrush" Color="#FF1B524A" />
    <SolidColorBrush x:Key="AppPrimarySoftBrush" Color="#FFD9EAE6" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#FFDEAB4E" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#FFFFF4DE" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF147A4B" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#FFDFF6E9" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#FF9B6200" />
    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#FFFFF1CF" />
    <SolidColorBrush x:Key="AppErrorBrush" Color="#FFB42318" />
    <SolidColorBrush x:Key="AppErrorSoftBrush" Color="#FFFDE7E5" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#FF185ABD" />
    <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#FFE8F1FC" />

    <SolidColorBrush x:Key="AppGlassBrush" Color="#FFFBFCFC" />
    <SolidColorBrush x:Key="AppGlassStrongBrush" Color="#FFF8FBFA" />
    <SolidColorBrush x:Key="AppGlassBorderBrush" Color="#FFC3CDD6" />
    <LinearGradientBrush x:Key="AppHeroOverlayBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0113432" Offset="0" />
        <GradientStop Color="#E8143E47" Offset="0.56" />
        <GradientStop Color="#CC102630" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
