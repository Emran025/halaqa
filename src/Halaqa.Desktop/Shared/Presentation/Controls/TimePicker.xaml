<UserControl x:Class="Halaqa.Desktop.Shared.Presentation.Controls.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="36">
    <ComboBox ItemsSource="{Binding Times, ElementName=Root}"
              SelectedItem="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsEditable="True"
              IsTextSearchEnabled="True"
              Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              FlowDirection="LeftToRight"
              ToolTip="اختر الوقت أو اكتبه بصيغة 24 ساعة مثل 18:00" />
</UserControl>
