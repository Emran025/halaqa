<UserControl x:Class="Halaqa.Desktop.Shared.Presentation.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             x:Name="Root"
             FlowDirection="RightToLeft">
    <Border Background="{StaticResource AppSurfaceMutedBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28"
            MaxWidth="460">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource AppPrimarySoftBrush}" HorizontalAlignment="Center">
                <controls:AppIcon Kind="InformationOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource SectionTitle}" TextAlignment="Center" Margin="0,14,0,5" />
            <TextBlock Text="{Binding Message, ElementName=Root}" Style="{StaticResource BodyMuted}" TextAlignment="Center" MaxWidth="420" />
            <Button Content="{Binding ActionText, ElementName=Root}" Command="{Binding ActionCommand, ElementName=Root}" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button.Style>
                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AppSecondaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
