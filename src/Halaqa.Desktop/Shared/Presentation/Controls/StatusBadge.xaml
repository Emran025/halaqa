<UserControl x:Class="Halaqa.Desktop.Shared.Presentation.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinHeight="30">
    <Border x:Name="BadgeBorder"
            Padding="11,4"
            CornerRadius="4"
            Background="{StaticResource AppSurfaceMutedBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1">
        <TextBlock x:Name="BadgeText"
                   Text="{Binding Text, ElementName=Root}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>
