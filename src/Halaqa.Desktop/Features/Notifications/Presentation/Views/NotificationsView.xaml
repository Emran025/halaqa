<UserControl x:Class="Halaqa.Desktop.Features.Notifications.Presentation.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button Content="رجوع" Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppOutlinedButton}" />
            <StackPanel>
                <TextBlock Text="الإشعارات" Style="{StaticResource PageTitle}" />
                <TextBlock Text="رسائل حسابك الرسمية من الخادم؛ لا تُخزن محلياً ولا تغير أي كيان مرتبط تلقائياً." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" Padding="14" CornerRadius="12" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Total, StringFormat=إجمالي الإشعارات: {0}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,0,8,0" />
                    <Button Content="{Binding UnreadOnly, StringFormat=غير المقروء فقط: {0}}" Command="{Binding ToggleUnreadOnlyCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,0,8,0" />
                    <Button Content="تعليم الكل كمقروء" Command="{Binding MarkAllReadCommand}" />
                    <ProgressBar Width="72" Height="4" Margin="10,0,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" Padding="12" CornerRadius="12" Margin="0,0,12,0">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Notifications}" SelectedItem="{Binding SelectedNotification}" MinHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" BorderBrush="#14000000" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Body}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding IsRead, StringFormat=مقروء: {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Top" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                        <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" Padding="16" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="تفاصيل الإشعار" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectedNotification.Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4" />
                    <TextBlock Text="{Binding SelectedNotification.Body}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedNotification.Type, StringFormat=النوع: {0}}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding SelectedNotification.Payload.Action, StringFormat=الإجراء المعلن: {0}}" Style="{StaticResource CaptionText}" />
                    <Button Content="تعليم كمقروء" Command="{Binding MarkSelectedReadCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
