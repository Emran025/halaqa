<UserControl x:Class="Halaqa.Desktop.Features.Notifications.Presentation.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <Grid Margin="28,24" MaxWidth="1000">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Connection Error Banner -->
                <RowDefinition Height="Auto" /> <!-- Filter & Actions Bar -->
                <RowDefinition Height="*" />    <!-- Notifications Full-Width List -->
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة إلى لوحة التحكم">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="الإشعارات" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="رسائل حسابك الرسمية وإشعارات الأنشطة والتنبيهات المباشرة." Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Full-Width Connection Error / Alert Banner -->
            <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="8" Padding="16,12" Background="#14DC3545" BorderBrush="#33DC3545" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Command="{Binding RefreshCommand}" Style="{StaticResource AppPrimaryButton}" Background="#FFC62828" Foreground="White" Padding="14,6" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="Replay" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="إعادة المحاولة" FontWeight="Bold" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AppIcon Kind="AlertCircleOutline" Foreground="#FFDC3545" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تنبيه الاتصال بالخادم" FontWeight="Bold" Foreground="#FFDC3545" FontSize="13" />
                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppInkBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Filter & Action Bar (Clean & Professional) -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16,10" Margin="0,0,0,16">
                <DockPanel LastChildFill="True">
                    <!-- Right: Clear Filter Tabs (الكل / غير المقروءة) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0A000000" CornerRadius="6" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="كل الإشعارات"
                                        Command="{Binding SelectFilterCommand}" CommandParameter="All"
                                        Padding="16,6" Margin="0,0,4,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="غير المقروءة فقط"
                                        Command="{Binding SelectFilterCommand}" CommandParameter="Unread"
                                        Padding="16,6" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterUnread}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AppPrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Left: Action Buttons (تحديث / تعليم الكل كمقروء) + Total Counter -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource AppOutlinedButton}" Padding="12,6" Margin="0,0,8,0">
                            <Button.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Kind="Replay" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="تحديث" FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </Button.ContentTemplate>
                        </Button>
                        <Button Command="{Binding MarkAllReadCommand}" Style="{StaticResource AppQuietButton}" Padding="12,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="CheckAll" FontSize="15" Margin="0,0,6,0" Foreground="{StaticResource AppPrimaryBrush}" />
                                <TextBlock Text="تعليم الكل كمقروء" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AppPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Total, StringFormat=الإجمالي: {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}" />
                        </Border>
                        <ProgressBar Width="70" Height="4" Margin="10,0,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Full-Width Notifications List -->
            <Border Grid.Row="3" Style="{StaticResource AppCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Notifications ItemsControl / List -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,14" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Unread Style: Soft primary tint and subtle border -->
                                                <Setter Property="Background" Value="#061B524A" />
                                                <Setter Property="BorderBrush" Value="#221B524A" />
                                                <Style.Triggers>
                                                    <!-- Read Style: Plain surface -->
                                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                        <Setter Property="Background" Value="#03000000" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0C1B524A" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Unread indicator dot -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Icon -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Content (Title, snippet, date) -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Action Buttons: Mark as read + View details -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Unread Dot -->
                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{StaticResource AppPrimaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Bell Icon -->
                                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="19" Background="#121B524A" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <controls:AppIcon Kind="BellOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Content: Title, Body Snippet, Time -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Body}" Style="{StaticResource BodyMuted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6" MaxHeight="38" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:AppIcon Kind="ClockOutline" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                                                    <Border Background="#0A000000" CornerRadius="3" Padding="6,1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{StaticResource AppMutedInkBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons on the Card -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                <!-- Direct Mark As Read Button (Visible only when unread) -->
                                                <Button Command="{Binding DataContext.MarkReadDirectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource AppOutlinedButton}"
                                                        Padding="10,5" Margin="0,0,8,0"
                                                        ToolTip="تعليم هذا الإشعار كمقروء">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButton}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Kind="Check" FontSize="13" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,4,0" />
                                                        <TextBlock Text="تعليم كمقروء" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Read badge when already read -->
                                                <Border Background="#0C000000" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="مقروء ✓" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                                                </Border>

                                                <!-- View Details Button (Opens Dialog) -->
                                                <Button Command="{Binding DataContext.OpenDetailDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource AppQuietButton}"
                                                        Padding="10,5"
                                                        ToolTip="عرض كامل تفاصيل الإشعار">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Kind="EyeOutline" FontSize="14" Margin="0,0,4,0" />
                                                        <TextBlock Text="عرض التفاصيل" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State Placeholder -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,60"
                                Visibility="{Binding HasNoNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#0A000000" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <controls:AppIcon Kind="BellOffOutline" Foreground="{StaticResource AppMutedInkBrush}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="لا توجد إشعارات حالياً" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="ستظهر هنا كافة الإشعارات والتنبيهات المباشرة فور وصولها." FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="12,6" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="12,6" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding LastPage, StringFormat=من إجمالي {0} صفحات}" VerticalAlignment="Center" Foreground="{StaticResource AppMutedInkBrush}" FontSize="12" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- NOTIFICATION DETAILS DIALOG (Modal Overlay)                       -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Background="#99000000"
                Visibility="{Binding IsDetailDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="300">
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12"
                    Width="520"
                    MaxHeight="500"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource AppSoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Command="{Binding CloseDetailDialogCommand}" Style="{StaticResource AppQuietButton}" Padding="6">
                            <controls:AppIcon Kind="Close" FontSize="16" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource AppPrimarySoftBrush}" Margin="0,0,10,0">
                                <controls:AppIcon Kind="BellOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تفاصيل الإشعار" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                <TextBlock Text="{Binding SelectedNotification.CreatedAt, StringFormat={}{0:f}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <!-- Dialog Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- Notification Title -->
                            <TextBlock Text="{Binding SelectedNotification.Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                            <!-- Notification Body Content Box -->
                            <Border Background="#081B524A" BorderBrush="#1F1B524A" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding SelectedNotification.Body}" FontSize="13" Foreground="{StaticResource AppInkBrush}" LineHeight="20" TextWrapping="Wrap" />
                            </Border>

                            <!-- Metadata Chips (Type, Payload, Read Status) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedNotification.Type, StringFormat=نوع الإشعار: {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}" />
                                </Border>
                                <Border Background="#0A000000" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedNotification.Payload.Action, StringFormat=الإجراء المرتبط: {0}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Actions (Mark as Read / Close) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="إغلاق" Command="{Binding CloseDetailDialogCommand}" Style="{StaticResource AppSecondaryButton}" Height="38" />
                        <Button Grid.Column="2"
                                Command="{Binding MarkReadDirectCommand}"
                                CommandParameter="{Binding SelectedNotification}"
                                Style="{StaticResource AppPrimaryButton}"
                                Height="38" Padding="16,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AppPrimaryButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNotification.IsRead}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="Check" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="تعليم كمقروء" FontWeight="Bold" FontSize="12" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
