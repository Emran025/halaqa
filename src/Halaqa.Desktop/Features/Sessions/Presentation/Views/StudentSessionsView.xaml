<UserControl x:Class="Halaqa.Desktop.Features.Sessions.Presentation.Views.StudentSessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:converters="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="NullToCollapsedConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="900">

            <!-- رأس الصفحة -->
            <DockPanel Margin="0,0,0,20">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left"
                        Style="{StaticResource AppBackButton}" ToolTip="العودة">
                    <controls:AppIcon Kind="ArrowRight"/>
                </Button>
                <StackPanel>
                    <TextBlock Text="جلساتي" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="سجل جلسات التسميع الخاصة بك — السابقة والجارية."
                               Style="{StaticResource BodyMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- بطاقة عنوان -->
            <Border Background="{StaticResource AppPrimarySoftBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1" CornerRadius="4"
                    Margin="0,0,0,16" Padding="20,14">
                <StackPanel Orientation="Horizontal">
                    <controls:AppIcon Kind="BookOpenPageVariantOutline"
                                      Foreground="{StaticResource AppPrimaryBrush}"
                                      FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Text="جلسات التسميع والحفظ"
                               Foreground="{StaticResource AppPrimaryBrush}"
                               FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- فلتر الحالة -->
            <Border Background="{StaticResource AppSurfaceBrush}" Padding="16,12"
                    CornerRadius="4" Margin="0,0,0,16">
                <DockPanel>
                    <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}"
                            DockPanel.Dock="Left" Margin="0,0,0,0"/>
                    <ComboBox ItemsSource="{Binding StateOptions}"
                              SelectedValue="{Binding StateFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              Margin="8,0,0,0"
                              ToolTip="فلتر الحالة"/>
                </DockPanel>
            </Border>

            <!-- رسالة حالة -->
            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding Message, Converter={StaticResource NullToCollapsedConverter}}"/>

            <!-- قائمة الجلسات -->
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                Padding="18,14" CornerRadius="8"
                                Margin="0,0,0,10"
                                Effect="{StaticResource AppSoftShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- تفاصيل الجلسة -->
                                <StackPanel Grid.Column="0">
                                    <!-- نوع التسميع -->
                                    <TextBlock Text="{Binding TaskType}"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="15" Margin="0,0,0,6"/>
                                    <!-- المعلم -->
                                    <DockPanel Margin="0,0,0,4">
                                        <controls:AppIcon Kind="AccountTie"
                                                          Foreground="{StaticResource AppPrimaryBrush}"
                                                          FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Teacher.Name, StringFormat=المعلم: {0}}"
                                                   Style="{StaticResource BodyMuted}"/>
                                    </DockPanel>
                                    <!-- الموعد -->
                                    <DockPanel Margin="0,0,0,4">
                                        <controls:AppIcon Kind="CalendarOutline"
                                                          Foreground="{StaticResource AppMutedInkBrush}"
                                                          FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding ScheduledAt, StringFormat=الموعد: {0:g}, TargetNullValue='—'}"
                                                   Style="{StaticResource CaptionText}"/>
                                    </DockPanel>
                                    <!-- وقت الانتهاء إن وُجد -->
                                    <DockPanel>
                                        <controls:AppIcon Kind="CheckCircleOutline"
                                                          Foreground="{StaticResource AppSuccessBrush}"
                                                          FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding EndedAt, StringFormat=انتهت: {0:g}, TargetNullValue='جارية'}"
                                                   Style="{StaticResource CaptionText}"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- شارة الحالة -->
                                <Border Grid.Column="1"
                                        Padding="12,6" CornerRadius="4"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0D155EEF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="Connected">
                                                    <Setter Property="Background" Value="#141F7A4D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="Ended">
                                                    <Setter Property="Background" Value="#0A000000"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}"
                                                             Value="Rejected">
                                                    <Setter Property="Background" Value="#14DC3545"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding State}"
                                               FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- رسالة عدم وجود جلسات -->
            <Border Background="{StaticResource AppSurfaceBrush}" Padding="24,32"
                    CornerRadius="8" Margin="0,0,0,16"
                    Visibility="{Binding HasNoSessions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <controls:AppIcon Kind="CalendarBlankOutline"
                                      FontSize="40" Foreground="{StaticResource AppMutedInkBrush}"
                                      HorizontalAlignment="Center"/>
                    <TextBlock Text="لا توجد جلسات بعد" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AppMutedInkBrush}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="ستظهر هنا جلساتك بعد أن يدعوك معلمك للتسميع."
                               Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ترقيم الصفحات -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}"
                        Style="{StaticResource AppOutlinedButton}"/>
                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}"
                           VerticalAlignment="Center" Margin="12,0"/>
                <TextBlock Text="{Binding Total, StringFormat=من إجمالي {0} جلسة}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Style="{StaticResource BodyMuted}"/>
                <Button Content="التالي" Command="{Binding LoadNextPageCommand}"
                        Style="{StaticResource AppOutlinedButton}"/>
            </StackPanel>

            <!-- مؤشر تحميل -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
