<UserControl x:Class="Halaqa.Desktop.Features.Sessions.Presentation.Views.LiveSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:sessionControls="clr-namespace:Halaqa.Desktop.Features.Sessions.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             Focusable="True"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <!-- Keyboard Arrow navigation for Quran pages -->
        <KeyBinding Key="Left" Command="{Binding NextMushafPageCommand}" />
        <KeyBinding Key="Right" Command="{Binding PreviousMushafPageCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextMushafPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousMushafPageCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <shared:QuranPageFontFamilyConverter x:Key="QuranPageFontFamilyConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Main Shell Bar -->
        <Border Grid.Row="0" Padding="18,10" Background="{StaticResource AppSurfaceBrush}" BorderBrush="#14000000" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource AppBackButton}"
                        Margin="0,0,12,0"
                        ToolTip="العودة لقائمة الطلاب">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AppIcon Kind="BookOpenPageVariantOutline" Width="22" Height="22" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StudentName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                            <Border Background="#1F1B524A" CornerRadius="3" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TaskType, StringFormat=جلسة {0}}" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding HalaqaName}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Mistake Badge, Stop Indicator & End Session Button -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- Stop Signal Badge (when teacher clicks verse ending) -->
                    <Border Background="#1A2E7D32" BorderBrush="#FF2E7D32" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding StopAyahNumber, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🛑 التوقف: آية " Foreground="#FF2E7D32" FontSize="12" FontWeight="Bold" />
                            <TextBlock Text="{Binding StopAyahNumber}" Foreground="#FF2E7D32" FontSize="13" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Clean Mistakes Count Badge (Calculated automatically from marked words) -->
                    <Border Background="#14DC3545" BorderBrush="#33DC3545" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:AppIcon Kind="AlertCircleOutline" Foreground="#FFDC3545" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="الأخطاء: " Foreground="#FFDC3545" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding MistakesCount}" Foreground="#FFDC3545" FontSize="14" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Complete Recitation Button → opens evaluation overlay -->
                    <Button Command="{Binding OpenEvaluationPanelCommand}"
                            Background="#FF1F7A4D"
                            Foreground="White"
                            Padding="14,8"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppIcon Kind="CalendarCheckOutline" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="إنهاء وتقييم التسميع" FontWeight="Bold" FontSize="12" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Connection indicator -->
                <Border DockPanel.Dock="Left" Background="#1200796B" CornerRadius="4" Padding="10,3" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource AppInfoBrush}" FontSize="11" />
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Body: Clean 50% / 50% Two-Column Layout -->
        <Grid Grid.Row="1" Margin="16,10">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Video Call & Direct Teacher Controls (50%) -->
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="14" />
                <!-- Column 1: Maximized Interactive Quran Page (50%) -->
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT 50%: Modern Dark Video Call & Teacher Interaction Card -->
            <Border Grid.Column="0" Background="#FF141D1A" CornerRadius="10" Padding="14" Effect="{StaticResource AppSoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Call Header with Status & Teacher Controls -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:AppIcon Kind="VideoOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="المكالمة المباشرة" FontSize="15" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                        <!-- Call State Badge -->
                        <Border DockPanel.Dock="Left" Background="#26FFFFFF" CornerRadius="4" Padding="10,4">
                            <TextBlock Text="{Binding CallStatusLabel}" Foreground="#FF64D2FF" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </DockPanel>

                    <!-- Video / Avatar Stream Area -->
                    <Border Grid.Row="1" Background="#FF1E2824" CornerRadius="8" Margin="0,0,0,10">
                        <Grid>
                            <!-- Avatar & Status Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="88" Height="88" CornerRadius="44" Background="#1A1B524A" BorderBrush="{StaticResource AppPrimaryBrush}" BorderThickness="2" HorizontalAlignment="Center">
                                    <controls:AppIcon Kind="Account" Foreground="{StaticResource AppPrimaryBrush}" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding StudentName}" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <TextBlock Text="{Binding CallStatusDescription}" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Small Self-Preview PIP in bottom right corner -->
                            <Border Width="105" Height="72" CornerRadius="6" Background="#FF0D1311" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10">
                                <Grid>
                                    <controls:AppIcon Kind="Account" Foreground="#66FFFFFF" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Text="معاينتي (المعلم)" FontSize="9" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Teacher Direct Controls Bar (One-click Quran visibility, student mic/camera management) -->
                    <Border Grid.Row="2" Background="#FF1C2622" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <DockPanel LastChildFill="False">
                            <!-- Toggle Mushaf Visibility for Student with 1 button -->
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding ToggleMushafVisibilityForStudentCommand}"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="8,5"
                                    ToolTip="إظهار / إخفاء المصحف من شاشة الطالب للتسميع الغيبي">
                                <controls:AppIcon Kind="BookOpenOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="16" />
                            </Button>

                            <!-- Control Student Mic / Cam -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ToggleStudentMicCommand}" Style="{StaticResource AppQuietButton}" Padding="6,4" Margin="0,0,4,0" ToolTip="كتم/تشغيل ميكروفون الطالب">
                                    <controls:AppIcon Kind="Microphone" Foreground="{StaticResource AppInfoBrush}" FontSize="13" />
                                </Button>
                                <Button Command="{Binding ToggleStudentCameraCommand}" Style="{StaticResource AppQuietButton}" Padding="6,4" ToolTip="إيقاف/تشغيل كاميرا الطالب">
                                    <controls:AppIcon Kind="VideoOutline" Foreground="{StaticResource AppInfoBrush}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Main Call Controls Floating Toolbar -->
                    <Border Grid.Row="3" Background="#FF1C2622" CornerRadius="20" Padding="12,5" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Teacher Toggle Mic -->
                            <Button Command="{Binding ToggleMicrophoneCommand}" Style="{StaticResource AppQuietButton}" Margin="0,0,8,0" Padding="8,6" ToolTip="كتم / تشغيل الميكروفون">
                                <controls:AppIcon Kind="Microphone" Foreground="White" FontSize="16" />
                            </Button>
                            <!-- Teacher Toggle Camera -->
                            <Button Command="{Binding ToggleCameraCommand}" Style="{StaticResource AppQuietButton}" Margin="0,0,8,0" Padding="8,6" ToolTip="تشغيل / إيقاف الكاميرا">
                                <controls:AppIcon Kind="VideoOutline" Foreground="White" FontSize="18" />
                            </Button>
                            <!-- Call Action Button -->
                            <Button Command="{Binding ToggleCallCommand}" Background="#FF1F7A4D" Foreground="White" Padding="9,6" BorderThickness="0" Cursor="Hand" ToolTip="بدء أو إنهاء الاتصال المباشر">
                                <controls:AppIcon Kind="Phone" Foreground="White" FontSize="17" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT 50%: Fully Maximized Quran Page (No top header; all info + navigation integrated in single bottom bar) -->
            <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" CornerRadius="10" Padding="10,8" Effect="{StaticResource AppSoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Fully Maximized Quran Box with boundary frame image & authentic 15 lines -->
                        <RowDefinition Height="*" />
                        <!-- Row 1: Unified Bottom Info & Navigation Bar (Right: Surah | Center: Page | Left: Juz) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Maximized Quran Frame (Occupies all available space from top to bottom) -->
                    <Grid Grid.Row="0">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="600" Height="853">
                                <!-- Quran Page Background -->
                                <Border Background="#FFFDFBF5" CornerRadius="4" Effect="{StaticResource AppSoftShadow}" />

                                <!-- Decorative Boundary Frame from boundery.png -->
                                <Image Source="/Assets/Images/boundery.png" Stretch="Fill" Opacity="0.95" />

                                <!-- Authentic 15-Line Quran Canvas Filling Boundary Frame -->
                                <Grid Margin="32,36,32,36">
                                    <sessionControls:InteractiveQuranCanvas
                                        QuranPage="{Binding QuranPage}"
                                        StudentId="{Binding StudentId}"
                                        StopAyahNumber="{Binding StopAyahNumber, Mode=TwoWay}"
                                        MistakesCount="{Binding MistakesCount, Mode=TwoWay}" />
                                </Grid>
                            </Grid>
                        </Viewbox>
                    </Grid>

                    <!-- Row 1: Unified Bottom Info & Navigation Card (Surah on Right, Page in Center, Juz on Left) -->
                    <Border Grid.Row="1" Background="#0A000000" CornerRadius="6" Padding="4" Margin="6,6,6,0">
                        <Button Command="{Binding OpenIndexDialogCommand}"
                                Style="{StaticResource AppQuietButton}"
                                Padding="10,6"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ToolTip="انقر لفتح فهرس المصحف الشريف والتنقل (السور، الأجزاء، الصفحات) - أو استخدم أسهم الكيبورد ◀ ▶">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Right: Surah Name -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <controls:AppIcon Kind="BookOpenOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding CurrentSurahName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                </StackPanel>

                                <!-- Center: Page Number Badge -->
                                <Border Grid.Column="1" Background="#1A1B524A" CornerRadius="10" Padding="14,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding QuranPage.PageNumber, StringFormat=صفحة {0}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" />
                                </Border>

                                <!-- Left: Juz Name & Dropdown Chevron -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentJuzText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppMutedInkBrush}" VerticalAlignment="Center" />
                                    <controls:AppIcon Kind="ChevronDown" FontSize="14" Foreground="{StaticResource AppMutedInkBrush}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Quran Navigation Dialog / Index Picker Modal (3 Tabs: السور, الأجزاء, الصفحات) -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#80000000"
                Visibility="{Binding IsIndexDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="100">
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="12"
                    Width="680"
                    Height="560"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource AppSoftShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Command="{Binding CloseIndexDialogCommand}"
                                Style="{StaticResource AppQuietButton}"
                                Padding="8,6">
                            <controls:AppIcon Kind="Close" FontSize="18" />
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:AppIcon Kind="BookOpenOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="22" Margin="0,0,8,0" />
                            <TextBlock Text="فهرس المصحف الشريف والتنقل" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 3 Segmented Top Tabs: السور | الأجزاء | الصفحات -->
                    <Border Grid.Row="1" Background="#0A000000" CornerRadius="8" Padding="4" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="📖 السور (114)"
                                    Command="{Binding SelectIndexTabCommand}"
                                    CommandParameter="Surahs"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="12,8"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Center" />

                            <Button Grid.Column="1"
                                    Content="📑 الأجزاء (30)"
                                    Command="{Binding SelectIndexTabCommand}"
                                    CommandParameter="Juzs"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="12,8"
                                    Margin="4,0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Center" />

                            <Button Grid.Column="2"
                                    Content="📄 الصفحات (604)"
                                    Command="{Binding SelectIndexTabCommand}"
                                    CommandParameter="Pages"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="12,8"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- TAB CONTENTS -->
                    <Grid Grid.Row="2">
                        <!-- TAB 1: SURAHS LIST -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndexTab}" Value="Surahs">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0"
                                     Text="{Binding IndexSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="ابحث باسم السورة (مثال: البقرة، الكهف، يس)"
                                     Margin="0,0,0,12" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredSurahs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSurahCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AppQuietButton}"
                                                    Padding="12,10"
                                                    Margin="0,0,0,4"
                                                    HorizontalContentAlignment="Stretch">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="30" Height="30" CornerRadius="15" Background="#141B524A" DockPanel.Dock="Right" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StartPage, StringFormat=صفحة {0}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding RevelationPlace}" FontSize="10" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Left" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, StringFormat=سورة {0}}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                                        <TextBlock Text="{Binding AyahCount, StringFormat={}{0} آية}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- TAB 2: JUZS LIST -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndexTab}" Value="Juzs">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AllJuzs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectJuzCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AppQuietButton}"
                                                    Padding="14,12"
                                                    Margin="4"
                                                    HorizontalContentAlignment="Stretch">
                                                <DockPanel LastChildFill="True">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#141B524A" DockPanel.Dock="Right" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Number}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding StartPage, StringFormat=صفحة {0}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- TAB 3: PAGES LIST -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedIndexTab}" Value="Pages">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AllPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource AppQuietButton}"
                                                    Width="52"
                                                    Height="42"
                                                    Margin="3"
                                                    Padding="0">
                                                <TextBlock Text="{Binding}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- EVALUATION OVERLAY — shown when teacher clicks "إنهاء وتقييم"    -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#CC000000"
                Visibility="{Binding IsEvaluationPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="200">
            <Border Background="{StaticResource AppSurfaceBrush}"
                    CornerRadius="14"
                    Width="600"
                    MaxHeight="680"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Effect="{StaticResource AppSoftShadow}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding CloseEvaluationPanelCommand}"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="8,6">
                                <controls:AppIcon Kind="Close" FontSize="18" />
                            </Button>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:AppIcon Kind="CalendarCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="24" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="تقييم جلسة التسميع" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                    <TextBlock Text="{Binding StudentName, StringFormat=الطالب: {0}}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Session Summary Box -->
                        <Border Grid.Row="1" Background="#0A000000" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Task Type -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="نوع التسميع" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TaskType}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Page -->
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="الصفحة" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TargetPage}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Stop Ayah -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="آية التوقف" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding StopAyahNumber, TargetNullValue='—'}" FontSize="14" FontWeight="Bold" Foreground="#FF2E7D32" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Total Mistakes -->
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="إجمالي الأخطاء" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding MistakesCount}" FontSize="14" FontWeight="Bold" Foreground="#FFDC3545" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Score So Far -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="التقدير" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding EvaluationRatingLabel}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mistake Breakdown Row -->
                        <Border Grid.Row="2" Background="#0A000000" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="تفاصيل الأخطاء المرصودة" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#20D32F2F" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding EvalMemorizationMistakes}" FontSize="14" FontWeight="Bold" Foreground="#FFD32F2F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="حفظ" FontSize="11" Foreground="#FFD32F2F" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#20E65100" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding EvalTajweedMistakes}" FontSize="14" FontWeight="Bold" Foreground="#FFE65100" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="تجويد" FontSize="11" Foreground="#FFE65100" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#20F9A825" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding EvalTashkeelMistakes}" FontSize="14" FontWeight="Bold" Foreground="#FFF57F17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="تشكيل" FontSize="11" Foreground="#FFF57F17" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#201976D2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding EvalAlertMistakes}" FontSize="14" FontWeight="Bold" Foreground="#FF1976D2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="تنبيه" FontSize="11" Foreground="#FF1976D2" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Star Score Selector (1-5) -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,20">
                            <TextBlock Text="التقييم الإجمالي للجلسة" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Score 5 -->
                                <Button Command="{Binding SetEvaluationScoreCommand}" CommandParameter="5"
                                        Padding="14,8" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScore5}" Value="True">
                                                    <Setter Property="Background" Value="#FF1F7A4D" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐⭐⭐⭐⭐" FontSize="13" />
                                        <TextBlock Text=" ممتاز" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <!-- Score 4 -->
                                <Button Command="{Binding SetEvaluationScoreCommand}" CommandParameter="4"
                                        Padding="14,8" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScore4}" Value="True">
                                                    <Setter Property="Background" Value="#FF1B524A" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐⭐⭐⭐" FontSize="13" />
                                        <TextBlock Text=" جيد جداً" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <!-- Score 3 -->
                                <Button Command="{Binding SetEvaluationScoreCommand}" CommandParameter="3"
                                        Padding="14,8" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScore3}" Value="True">
                                                    <Setter Property="Background" Value="#FF795548" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐⭐⭐" FontSize="13" />
                                        <TextBlock Text=" جيد" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <!-- Score 2 -->
                                <Button Command="{Binding SetEvaluationScoreCommand}" CommandParameter="2"
                                        Padding="14,8" Margin="0,0,6,0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScore2}" Value="True">
                                                    <Setter Property="Background" Value="#FFEF6C00" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐⭐" FontSize="13" />
                                        <TextBlock Text=" مقبول" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <!-- Score 1 -->
                                <Button Command="{Binding SetEvaluationScoreCommand}" CommandParameter="1"
                                        Padding="14,8" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppQuietButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScore1}" Value="True">
                                                    <Setter Property="Background" Value="#FFC62828" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="13" />
                                        <TextBlock Text=" ضعيف" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Notes Field + Action Buttons -->
                        <Grid Grid.Row="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="ملاحظات الجلسة (اختياري)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" Margin="0,0,0,8" />
                            <TextBox Grid.Row="1"
                                     Text="{Binding EvaluationNotes, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="70"
                                     MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Cancel -->
                                <Button Grid.Column="0"
                                        Command="{Binding CloseEvaluationPanelCommand}"
                                        Style="{StaticResource AppQuietButton}"
                                        Padding="14,10"
                                        HorizontalContentAlignment="Center">
                                    <TextBlock Text="تراجع — العودة للتسميع" FontWeight="SemiBold" />
                                </Button>

                                <!-- Confirm -->
                                <Button Grid.Column="2"
                                        Command="{Binding ConfirmEvaluationCommand}"
                                        Background="#FF1F7A4D"
                                        Foreground="White"
                                        Padding="22,10"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:AppIcon Kind="CheckCircleOutline" Foreground="White" FontSize="16" Margin="0,0,8,0" />
                                        <TextBlock Text="تأكيد وحفظ التقييم" FontWeight="Bold" FontSize="13" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
