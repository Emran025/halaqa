<UserControl x:Class="Halaqa.Desktop.Features.Notes.Presentation.Views.TaskNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24" MaxWidth="820">
            <DockPanel Margin="0,0,0,20">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة إلى المهام">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel>
                    <TextBlock Text="ملاحظات المهمة" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding TaskTitle}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Background="#0D155EEF" Padding="14" CornerRadius="4" Margin="0,0,0,16">
                <DockPanel>
                    <controls:AppIcon Kind="InformationOutline" Foreground="{StaticResource AppInfoBrush}" Width="22" Height="22" Margin="0,0,10,0"  />
                    <TextBlock Text="تظهر الملاحظات التي يعيدها الخادم للمهمة. يمكن تعديل أو حذف الملاحظة التي أنشأتها أنت فقط؛ يبقى الخادم صاحب القرار النهائي." TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Background="{StaticResource AppSurfaceBrush}" Padding="16" CornerRadius="4" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="إضافة ملاحظة تعليمية أو استفسار" Style="{StaticResource SectionTitle}" />
                    <TextBox Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}" ToolTip="نص الملاحظة (1–2000 حرف)" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,12,0,12" />
                    <Button Content="إضافة الملاحظة" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Notes.Count, StringFormat=عدد الملاحظات: {0}}" Style="{StaticResource BodyMuted}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" BorderThickness="0" Background="Transparent" MinHeight="160">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AppSurfaceBrush}" Padding="14" CornerRadius="4" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Author.Name, StringFormat=الكاتب: {0}}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CreatedAt, StringFormat=تاريخ الإنشاء: {0:g}}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Background="{StaticResource AppSurfaceBrush}" Padding="16" CornerRadius="4" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="تعديل ملاحظتي المختارة" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="تُفعّل أزرار الحفظ والحذف فقط إذا كانت الملاحظة المختارة من إنشائك." Style="{StaticResource BodyMuted}" Margin="0,4,0,8" />
                    <TextBox Text="{Binding EditBody, UpdateSourceTrigger=PropertyChanged}" ToolTip="النص المحدّث (1–2000 حرف)" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,0,8,0" />
                        <Button Content="حفظ التعديل" Command="{Binding UpdateCommand}" Margin="0,0,8,0" />
                        <Button Content="حذف ملاحظتي" Command="{Binding DeleteCommand}" Style="{StaticResource AppOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppInfoBrush}" TextWrapping="Wrap" Margin="0,16,0,0" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
