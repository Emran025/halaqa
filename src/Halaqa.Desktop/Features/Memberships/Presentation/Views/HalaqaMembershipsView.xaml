<UserControl x:Class="Halaqa.Desktop.Features.Memberships.Presentation.Views.HalaqaMembershipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppElevatedCard}" MaxWidth="1080" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى الحلقات" Style="{StaticResource AppBackButton}">
                        <controls:AppIcon Kind="ArrowRight" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="إدارة عضويات الحلقة" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding HalaqaName, StringFormat=الحلقة: {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="#0A000000" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="الطلاب في الحلقة" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Total, StringFormat=الإجمالي: {0}}" Style="{StaticResource BodyMuted}" />
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,12,0,8">
                            <Button DockPanel.Dock="Left" Content="إسناد الطالب" Command="{Binding AssignCommand}" Style="{StaticResource AppPrimaryButton}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="معرّف الطالب المقبول (UUID)" />
                        </DockPanel>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Memberships}" SelectedItem="{Binding SelectedMembership}" Margin="0,4,0,8" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,3">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource BodyMuted}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Student.Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Student.Email}" Style="{StaticResource BodyMuted}" FlowDirection="LeftToRight" />
                                                <TextBlock Text="{Binding JoinedAt, StringFormat=انضم في: {0:yyyy-MM-dd}}" Style="{StaticResource BodyMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="3">
                            <TextBlock Text="{Binding StudentIdError}" Style="{StaticResource FieldError}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=الصفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Button Grid.Row="2" Content="إعادة تحميل العضويات" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
