<UserControl x:Class="Halaqa.Desktop.Features.Memberships.Presentation.Views.HalaqaMembershipsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <shared:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <shared:MembershipStatusToTextConverter x:Key="MembershipStatusToTextConverter" />
        <shared:MembershipStatusToBackgroundBrushConverter x:Key="MembershipStatusToBackgroundBrushConverter" />
        <shared:MembershipStatusToForegroundBrushConverter x:Key="MembershipStatusToForegroundBrushConverter" />
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <!-- Main Full-Screen Layout -->
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة إلى إدارة الحلقات">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إدارة عضويات الحلقة" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding HalaqaName, StringFormat=الحلقة: {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Search & Filter Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="ابحث باسم الطالب أو بريده أو هاتفه" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" Padding="8,0" />
                        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedValue="{Binding FilterStatus}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="160" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" />
                        <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}" Style="{StaticResource AppPrimaryButton}" Padding="18,0" Height="36" Margin="0,0,10,0" />
                        <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,0" Height="36" Margin="0,0,10,0" />
                        <Button Content="إسناد طالب جديد" Command="{Binding OpenAssignDialogCommand}" Style="{StaticResource AppPrimaryButton}" Padding="16,0" Height="36" />
                        <ProgressBar Width="70" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource AppSurfaceMutedBrush}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلاب: {0}}" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Full-Width Memberships List Area -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Scrollable Memberships -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Memberships}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,10" Background="{StaticResource AppSurfaceBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Column 0: Avatar (Right in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Column 1: Info (Middle) -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Column 2: Action Button (Left in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Student Avatar on Column 0 (Right) -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AppPrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Student Info & Status in Column 1 (Middle) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Student.Name}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AppInkBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{Binding Status, Converter={StaticResource MembershipStatusToBackgroundBrushConverter}}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status, Converter={StaticResource MembershipStatusToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding Status, Converter={StaticResource MembershipStatusToForegroundBrushConverter}}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Student.Email}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" FlowDirection="LeftToRight" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding Student.Phone, StringFormat=هاتف: {0}}" Visibility="{Binding Student.Phone, Converter={StaticResource StringToVisibilityConverter}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding JoinedAt, StringFormat=تاريخ الانضمام: {0:yyyy-MM-dd}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Button in Column 2 (Left) -->
                                            <Button Grid.Column="2" Content="إدارة العضوية" Command="{Binding DataContext.OpenManageDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AppPrimaryButton}" Padding="18,8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasNoMemberships, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:AppIcon Kind="AccountGroupOutline" FontSize="48" Foreground="{StaticResource AppBorderBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا يوجد طلاب في هذه الحلقة حالياً" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="يمكنك إسناد طالب جديد إلى الحلقة أو تعديل خيارات التصفية أو النقر على تحديث" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلاب: {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AppMutedInkBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay Modal Dialog for Assign & Manage -->
        <Grid Background="#7F000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource AppElevatedCard}" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Background="{StaticResource AppSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource PageTitle}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Command="{Binding CloseDialogCommand}" Style="{StaticResource AppBackButton}" ToolTip="إغلاق" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <controls:AppIcon Kind="Close" />
                        </Button>
                    </Grid>

                    <!-- Dialog Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12" />

                            <!-- Status Message / Feedback -->
                            <Border Background="{StaticResource AppInfoSoftBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14" Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppInkBrush}" TextWrapping="Wrap" FontSize="12" />
                            </Border>

                            <!-- Mode 1: Assign Student Mode -->
                            <StackPanel Visibility="{Binding IsAssignMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="إسناد طالب جديد إلى الحلقة" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="أدخل معرّف الطالب (UUID) المقبول لإضافته كعضو نشط في هذه الحلقة مباشرة." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        
                                        <TextBlock Text="معرّف الطالب (UUID) *" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding StudentId, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" Height="36" Padding="8,0" ToolTip="معرّف الطالب بصيغة UUID" />
                                        <TextBlock Text="{Binding StudentIdError}" Style="{StaticResource FieldError}" />

                                        <Button Content="إسناد الطالب إلى الحلقة" Command="{Binding AssignCommand}" Style="{StaticResource AppPrimaryButton}" HorizontalAlignment="Left" Padding="18,8" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Mode 2: Manage Membership Mode -->
                            <StackPanel Visibility="{Binding IsAssignMode, Converter={StaticResource InverseBooleanConverter}}">
                                <!-- Student Summary Card -->
                                <Border Background="{StaticResource AppSurfaceMutedBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding SelectedMembership.Student.Name}" FontWeight="Bold" FontSize="15" />
                                            <Border DockPanel.Dock="Left" Background="{Binding SelectedMembership.Status, Converter={StaticResource MembershipStatusToBackgroundBrushConverter}}" CornerRadius="4" Padding="8,2">
                                                <TextBlock Text="{Binding SelectedMembership.Status, Converter={StaticResource MembershipStatusToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedMembership.Status, Converter={StaticResource MembershipStatusToForegroundBrushConverter}}" />
                                            </Border>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding SelectedMembership.Student.Email}" Style="{StaticResource CaptionText}" FlowDirection="LeftToRight" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding SelectedMembership.Student.Phone, StringFormat=هاتف: {0}}" Visibility="{Binding SelectedMembership.Student.Phone, Converter={StaticResource StringToVisibilityConverter}}" Style="{StaticResource CaptionText}" Margin="0,0,16,0" />
                                            <TextBlock Text="{Binding SelectedMembership.JoinedAt, StringFormat=تاريخ الانضمام: {0:yyyy-MM-dd}}" Style="{StaticResource CaptionText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Change Status Card -->
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="تعديل حالة العضوية" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        
                                        <TextBlock Text="حالة العضوية *" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                                        <ComboBox ItemsSource="{Binding MembershipStatusOptions}" SelectedValue="{Binding SelectedStatus}" SelectedValuePath="Value" DisplayMemberPath="Label" Height="36" />
                                        <TextBlock Text="{Binding StatusError}" Style="{StaticResource FieldError}" />

                                        <TextBlock Text="سبب تغيير الحالة (اختياري):" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" ToolTip="سبب تغيير الحالة" />
                                        <TextBlock Text="{Binding ReasonError}" Style="{StaticResource FieldError}" />

                                        <Button Content="تحديث حالة العضوية" Command="{Binding UpdateStatusCommand}" Style="{StaticResource AppPrimaryButton}" HorizontalAlignment="Left" Padding="18,8" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Remove Student Card -->
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="إلغاء عضوية الطالب من الحلقة" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="سيتم استبعاد الطالب من هذه الحلقة مع الحفاظ على سجله التاريخي ونشاطاته السابقة في النظام." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Button Content="إزالة الطالب من الحلقة" Command="{Binding RemoveCommand}" Style="{StaticResource AppDangerButton}" HorizontalAlignment="Left" Padding="18,8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <Button Content="إغلاق" Command="{Binding CloseDialogCommand}" Style="{StaticResource AppOutlinedButton}" HorizontalAlignment="Left" Padding="18,6" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
