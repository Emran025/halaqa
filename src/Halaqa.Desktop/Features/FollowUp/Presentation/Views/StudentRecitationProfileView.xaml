<UserControl x:Class="Halaqa.Desktop.Features.FollowUp.Presentation.Views.StudentRecitationProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="StatBadge" TargetType="{x:Type Border}" BasedOn="{StaticResource AppCard}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource AppCanvasBrush}">
        <Grid Margin="24,20" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding GoBackCommand}"
                        Style="{StaticResource AppBackButton}"
                        ToolTip="العودة لقائمة الطلاب">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StudentName, StringFormat=ملف الطالب: {0}}" Style="{StaticResource DisplayTitle}" />
                    <TextBlock Text="{Binding HalaqaName, StringFormat=الحلقة: {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Profile Overview Card -->
            <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="24,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Avatar Circle -->
                    <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                            Background="#141B524A" BorderBrush="{StaticResource AppPrimaryBrush}" BorderThickness="2">
                        <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="40"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <!-- Student Details -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StudentName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="{Binding StudentCode}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#0A000000" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding HalaqaName}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <controls:AppIcon Kind="ClockOutline" FontSize="13" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding AttendanceFrom, StringFormat=من {0}}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" />
                            <TextBlock Text="{Binding AttendanceTo, StringFormat= — {0}}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick actions: only the task types in the student's plan -->
                    <WrapPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Command="{Binding StartMemorizationRecitationCommand}"
                                Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource AppPrimaryButton}"
                                Padding="12,8" Margin="0,0,8,0"
                                ToolTip="بدء جلسة حفظ">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="BookOpenPageVariantOutline" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="حفظ" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartReviewRecitationCommand}"
                                Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource AppQuietButton}"
                                Padding="12,8" Margin="0,0,8,0"
                                ToolTip="بدء جلسة مراجعة">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="Replay" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="مراجعة" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StartSardRecitationCommand}"
                                Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource AppOutlinedButton}"
                                Padding="12,8"
                                ToolTip="بدء جلسة سرد">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="Microphone" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="سرد" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Stats Row (4 cards) -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Memorization Page -->
                <Border Grid.Column="0" Style="{StaticResource StatBadge}" Background="#0F1B524A" BorderBrush="#221B524A" Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📖 صفحة الحفظ" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentMemorizationPage}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Review Page -->
                <Border Grid.Column="1" Style="{StaticResource StatBadge}" Background="#0FF57F17" BorderBrush="#22F57F17" Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🔄 صفحة المراجعة" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentReviewPage}" FontSize="26" FontWeight="Bold" Foreground="#FFF57F17" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Total Sessions -->
                <Border Grid.Column="2" Style="{StaticResource StatBadge}" Background="#0F1F7A4D" BorderBrush="#221F7A4D" Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="جلسات التسميع" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalSessions}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Average Score -->
                <Border Grid.Column="3" Style="{StaticResource StatBadge}" Margin="0" Background="#0A000000">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="متوسط التقييم" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AverageScore, StringFormat={}{0}/5}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Session History Table -->
            <Border Grid.Row="3" Style="{StaticResource AppCard}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="10,10,0,0" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="التاريخ والوقت" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="نوع التسميع" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="الصفحة" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="حفظ" FontSize="12" FontWeight="Bold" Foreground="#FFD32F2F" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="تجويد" FontSize="12" FontWeight="Bold" Foreground="#FFE65100" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="تشكيل" FontSize="12" FontWeight="Bold" Foreground="#FFF57F17" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="تنبيه" FontSize="12" FontWeight="Bold" Foreground="#FF1976D2" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="7" Text="التقييم" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Left" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <ItemsControl ItemsSource="{Binding SessionHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#04000000" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:dd/MM/yyyy}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" />
                                                <TextBlock Text="{Binding CompletedAt, StringFormat={}{0:hh:mm tt}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TaskType}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding TargetPage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="3" Text="{Binding Mistakes.MemorizationCount}" FontSize="14" FontWeight="Bold" Foreground="#FFD32F2F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding Mistakes.TajweedCount}" FontSize="14" FontWeight="Bold" Foreground="#FFE65100" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{Binding Mistakes.TashkeelCount}" FontSize="14" FontWeight="Bold" Foreground="#FFF57F17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{Binding Mistakes.AlertCount}" FontSize="14" FontWeight="Bold" Foreground="#FF1976D2" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="7" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Rating}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" />
                                                <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalSessions}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <controls:AppIcon Kind="HistoryIcon" FontSize="48" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا توجد جلسات تسميع مسجلة بعد" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="ابدأ جلسة تسميع من الأزرار أعلاه لتظهر هنا" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
