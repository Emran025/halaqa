<UserControl x:Class="Halaqa.Desktop.Features.FollowUp.Presentation.Views.FollowUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36" MaxWidth="1040">
            <DockPanel Margin="0,0,0,20">
                <Button Content="رجوع" Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppOutlinedButton}" />
                <StackPanel>
                    <TextBlock Text="خطة المتابعة والحضور" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="الخطة والحضور وعناصر المتابعة بيانات رسمية من الخادم. هذه الصفحة مهيأة لحساب الطالب الحالي فقط." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <Border Background="#0D155EEF" Padding="14" CornerRadius="10" Margin="0,0,0,16">
                <DockPanel>
                    <controls:AppIcon Kind="InformationOutline" Foreground="{StaticResource AppInfoBrush}" Width="22" Height="22" Margin="0,0,10,0"  />
                    <TextBlock Text="لا تتيح هذه الرحلة اختيار طالب آخر للمعلم حتى تتوفر رحلة قائمة طلاب مطابقة لعقد Laravel." TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" Padding="20" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="خطة الحفظ والمراجعة" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="تدعم الخطة تفصيلاً واحداً أو أكثر؛ راجع النوع والوحدة والكمية لكل تفصيل قبل الحفظ." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="التكرار" Style="{StaticResource BodyMuted}" />
                        <ComboBox ItemsSource="{Binding FrequencyOptions}" SelectedItem="{Binding Frequency}" />
                        <ItemsControl ItemsSource="{Binding PlanDetails}" Margin="0,10,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#16000000" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DataContext.TaskTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding TaskType}" ToolTip="نوع المهمة" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.UnitOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Unit}" ToolTip="الوحدة" Margin="6,0" />
                                            <TextBox Grid.Column="2" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" ToolTip="الكمية" Margin="6,0" />
                                            <TextBox Grid.Column="3" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" ToolTip="ملاحظات (حتى 500)" Margin="6,0" />
                                            <Button Grid.Column="4" Command="{Binding DataContext.RemovePlanDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="حذف التفصيل"><controls:AppIcon Kind="Close"  /></Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="إضافة تفصيل للخطة" Command="{Binding AddPlanDetailCommand}" HorizontalAlignment="Right" Style="{StaticResource AppSecondaryButton}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="تاريخ البداية (YYYY-MM-DD)" Style="{StaticResource BodyMuted}"/><TextBox Text="{Binding StartsOn, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="تاريخ النهاية (YYYY-MM-DD)" Style="{StaticResource BodyMuted}"/><TextBox Text="{Binding EndsOn, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                        </Grid>
                        <Button Content="حفظ الخطة" Command="{Binding SavePlanCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource AppSurfaceBrush}" Padding="20" CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="أوقات الحضور" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="أضف نطاق حضور أسبوعياً واحداً أو أكثر. يجب أن يكون وقت النهاية بعد البداية لكل نطاق." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,12" />
                        <TextBlock Text="المنطقة الزمنية" Style="{StaticResource BodyMuted}" />
                        <TextBox Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}" />
                        <ItemsControl ItemsSource="{Binding WeeklySlots}" Margin="0,10,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#16000000" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" /><ColumnDefinition Width="110" /><ColumnDefinition Width="110" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding DataContext.WeekDayOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding DayOfWeek}" ToolTip="اليوم (0–6)" />
                                            <TextBox Grid.Column="1" Text="{Binding From, UpdateSourceTrigger=PropertyChanged}" ToolTip="من HH:mm" Margin="6,0" />
                                            <TextBox Grid.Column="2" Text="{Binding To, UpdateSourceTrigger=PropertyChanged}" ToolTip="إلى HH:mm" Margin="6,0" />
                                            <CheckBox Grid.Column="3" Content="مفضل" IsChecked="{Binding Preferred}" VerticalAlignment="Center" Margin="6,0" />
                                            <Button Grid.Column="4" Command="{Binding DataContext.RemoveAvailabilitySlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="حذف نطاق الحضور"><controls:AppIcon Kind="Close"  /></Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="إضافة نطاق حضور" Command="{Binding AddAvailabilitySlotCommand}" HorizontalAlignment="Right" Style="{StaticResource AppSecondaryButton}" />
                        <TextBlock Text="المدة المفضلة بالدقائق" Style="{StaticResource BodyMuted}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding PreferredSessionDurationMinutes, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="حفظ الحضور" Command="{Binding SaveAvailabilityCommand}" HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource AppSurfaceBrush}" Padding="20" CornerRadius="12" Margin="0,0,0,18">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="عناصر المتابعة اليومية" Style="{StaticResource SectionTitle}" />
                        <Button Content="تحديث" Command="{Binding RefreshItemsCommand}" DockPanel.Dock="Left" Style="{StaticResource AppOutlinedButton}" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Margin="0,12,0,0" MinHeight="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" BorderBrush="#16000000" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TaskType}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ScheduledFor, StringFormat=موعد: {0:g}}" Style="{StaticResource BodyMuted}" />
                                            <TextBlock Text="{Binding PlanDetail.Notes}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="مكتمل" Command="{Binding CompleteSelectedItemCommand}" Margin="0,0,8,0" />
                        <TextBox Width="220" Text="{Binding SkipReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="سبب التجاوز" Margin="0,0,8,0" />
                        <Button Content="تجاوز" Command="{Binding SkipSelectedItemCommand}" Margin="0,0,8,0" />
                        <TextBox Width="230" Text="{Binding RescheduledAt, UpdateSourceTrigger=PropertyChanged}" ToolTip="موعد جديد" Margin="0,0,8,0" />
                        <TextBox Width="180" Text="{Binding RescheduleReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="سبب إعادة الجدولة" Margin="0,0,8,0" />
                        <Button Content="إعادة جدولة" Command="{Binding RescheduleSelectedItemCommand}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="السابق" Command="{Binding LoadPreviousItemsPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                        <TextBlock Text="{Binding ItemsCurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Content="التالي" Command="{Binding LoadNextItemsPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource AppSurfaceBrush}" Padding="20" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="سجل الحضور والمتابعة" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Trackings}" Margin="0,12,0,0" MinHeight="80">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="6">
                                    <TextBlock Text="{Binding AttendanceType}" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" Margin="12,0" />
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
