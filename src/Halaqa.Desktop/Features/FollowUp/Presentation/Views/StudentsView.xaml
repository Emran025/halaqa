<UserControl x:Class="Halaqa.Desktop.Features.FollowUp.Presentation.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="StudentCard" TargetType="{x:Type Border}" BasedOn="{StaticResource AppCard}">
            <Setter Property="Width" Value="310" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource AppCanvasBrush}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource AppBackButton}"
                        ToolTip="العودة للرئيسية">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="قائمة الطلاب" Style="{StaticResource DisplayTitle}" />
                    <TextBlock Text="جميع طلابك من كل الحلقات — انقر على طالب لعرض ملفه وسجل تسميعاته" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding LoadStudentsCommand}"
                        Style="{StaticResource AppQuietButton}"
                        Margin="12,0,0,0" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Kind="Replay" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="تحديث" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Stats Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource AppCard}" Padding="16,10" Margin="0,0,8,0" Background="#0F1B524A" BorderBrush="#331B524A">
                    <DockPanel LastChildFill="True">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#241B524A" DockPanel.Dock="Right" Margin="0,0,10,0">
                            <controls:AppIcon Kind="AccountGroupOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إجمالي الطلاب" Foreground="{StaticResource AppPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalStudents}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource AppCard}" Padding="16,10" Margin="0,0,8,0" Background="#0FF57F17" BorderBrush="#33F57F17">
                    <DockPanel LastChildFill="True">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#24F57F17" DockPanel.Dock="Right" Margin="0,0,10,0">
                            <controls:AppIcon Kind="CalendarTodayOutline" Foreground="#FFF57F17" FontSize="18" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="المتوقع اليوم" Foreground="#FFF57F17" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayCount}" FontSize="20" FontWeight="Bold" Foreground="#FFF57F17" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="16,10" Margin="0" Background="#0F1F7A4D" BorderBrush="#331F7A4D">
                    <DockPanel LastChildFill="True">
                        <Border Width="36" Height="36" CornerRadius="8" Background="#241F7A4D" DockPanel.Dock="Right" Margin="0,0,10,0">
                            <controls:AppIcon Kind="AccountMultipleCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="18" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="أنهوا تسميعهم اليوم" Foreground="{StaticResource AppSuccessBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompletedCount}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Search & Filter Bar -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="14,10" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="ابحث باسم الطالب أو رمز الحساب أو الحلقة"
                             VerticalAlignment="Center"
                             Margin="0,0,14,0" />
                    <Border Grid.Column="1" Background="#0A000000" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="الكل"
                                    Command="{Binding SelectFilterTabCommand}" CommandParameter="All"
                                    Style="{StaticResource AppQuietButton}" Padding="14,6" Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="اليوم"
                                    Command="{Binding SelectFilterTabCommand}" CommandParameter="Today"
                                    Style="{StaticResource AppQuietButton}" Padding="14,6" Margin="0,0,4,0" Cursor="Hand" />
                            <Button Content="أنهوا"
                                    Command="{Binding SelectFilterTabCommand}" CommandParameter="Completed"
                                    Style="{StaticResource AppQuietButton}" Padding="14,6" Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Loading / Error -->
            <ProgressBar Grid.Row="3" VerticalAlignment="Top" Height="3" IsIndeterminate="True" Margin="0,0,0,6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Students Grid (WrapPanel centered — 3 on default, 4 on wide) -->
            <Grid Grid.Row="3" HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding DisplayedStudents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StudentCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Avatar + Name -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                                        <Border Width="44" Height="44" CornerRadius="22" Background="#141B524A"
                                                BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                                                DockPanel.Dock="Right" Margin="0,0,12,0">
                                            <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="22" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StudentName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                            <TextBlock Text="{Binding HalaqaName}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StudentCode}" FontSize="10" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Progress Compact: only the student's configured plan types -->
                                    <Border Grid.Row="1" Background="#07000000" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                        <WrapPanel HorizontalAlignment="Center">
                                            <StackPanel Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0" HorizontalAlignment="Center">
                                                <TextBlock Text="حفظ" FontSize="11" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentMemorizationPage, StringFormat=ص{0}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0" HorizontalAlignment="Center">
                                                <TextBlock Text="مراجعة" FontSize="11" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentReviewPage, StringFormat=ص{0}}" FontSize="11" FontWeight="Bold" Foreground="#FF995C00" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0" HorizontalAlignment="Center">
                                                <TextBlock Text="سرد" FontSize="11" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentRecitationPage, StringFormat=ص{0}}" FontSize="11" FontWeight="Bold" Foreground="#FF007799" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Border>

                                    <!-- Last Evaluation + Mistakes Badge -->
                                    <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
                                        <Border DockPanel.Dock="Left" Background="#0ADC3545" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalMistakesRecorded, StringFormat={}{0} خطأ}" FontSize="10" Foreground="#FFDC3545" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding LastEvaluation}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppSuccessBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Action Row: profile plus one action per configured plan type -->
                                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenStudentProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppQuietButton}"
                                                Padding="7,6" Margin="2,0"
                                                ToolTip="فتح الملف الشخصي وسجل التسميعات">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Kind="AccountEditOutline" FontSize="13" Margin="0,0,4,0" />
                                                <TextBlock Text="الملف الشخصي" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.StartMemorizationRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppPrimaryButton}"
                                                Padding="7,6" Margin="2,0"
                                                ToolTip="بدء جلسة تسميع الحفظ">
                                            <TextBlock Text="حفظ" FontSize="11" FontWeight="Bold" Foreground="White" />
                                        </Button>
                                        <Button Command="{Binding DataContext.StartReviewRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppQuietButton}"
                                                Padding="7,6" Margin="2,0"
                                                ToolTip="بدء جلسة تسميع المراجعة">
                                            <TextBlock Text="مراجعة" FontSize="11" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Command="{Binding DataContext.StartSardRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppOutlinedButton}"
                                                Padding="7,6" Margin="2,0"
                                                ToolTip="بدء جلسة تسميع السرد">
                                            <TextBlock Text="سرد" FontSize="11" FontWeight="SemiBold" />
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
