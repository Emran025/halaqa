<UserControl x:Class="Halaqa.Desktop.Features.FollowUp.Presentation.Views.ComprehensiveTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:vm="clr-namespace:Halaqa.Desktop.Features.FollowUp.Presentation.ViewModels"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="StatCard" TargetType="{x:Type Border}" BasedOn="{StaticResource AppCard}">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="MinHeight" Value="72" />
        </Style>

        <Style x:Key="StudentCard" TargetType="{x:Type Border}" BasedOn="{StaticResource AppCard}">
            <Setter Property="Width" Value="295" />
            <Setter Property="Margin" Value="8,8,8,8" />
            <Setter Property="Padding" Value="14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppCanvasBrush}">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <Button DockPanel.Dock="Left"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource AppBackButton}"
                        ToolTip="العودة للرئيسية">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="المتابعة الشاملة للطلاب" Style="{StaticResource DisplayTitle}" />
                    <TextBlock Text="متابعة الحفظ والمراجعة والسرد اليومي، وبدء جلسات التسميع المباشرة بالمصحف" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Left"
                        Command="{Binding LoadStudentsCommand}"
                        Style="{StaticResource AppQuietButton}"
                        Margin="12,0,0,0"
                        Padding="12,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Kind="Replay" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="تحديث البيانات" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Stats Bar -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}" Background="#0F1B524A" BorderBrush="#331B524A">
                    <DockPanel LastChildFill="True">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#241B524A" DockPanel.Dock="Right" Margin="0,0,12,0">
                            <controls:AppIcon Kind="CalendarCheckOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="20" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="المتوقع تسميعهم اليوم" Foreground="{StaticResource AppPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ExpectedTodayCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource StatCard}" Background="#0F1F7A4D" BorderBrush="#331F7A4D">
                    <DockPanel LastChildFill="True">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#241F7A4D" DockPanel.Dock="Right" Margin="0,0,12,0">
                            <controls:AppIcon Kind="AccountMultipleCheckOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="20" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تم إنجازهم اليوم" Foreground="{StaticResource AppSuccessBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CompletedTodayCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppSuccessBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}" Margin="0">
                    <DockPanel LastChildFill="True">
                        <Border Width="40" Height="40" CornerRadius="8" Background="#14000000" DockPanel.Dock="Right" Margin="0,0,12,0">
                            <controls:AppIcon Kind="AccountGroupOutline" Foreground="{StaticResource AppInkBrush}" FontSize="20" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إجمالي طلاب المعلم" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding AllStudentsCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Search and Filter Tabs -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="ابحث باسم الطالب أو رمز الحساب أو الحلقة"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0" />

                    <!-- Filter Buttons styled as tabs -->
                    <Border Grid.Column="1" Background="#0F000000" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="المتوقع اليوم"
                                    Command="{Binding SelectFilterTabCommand}"
                                    CommandParameter="ExpectedToday"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="14,6"
                                    Margin="0,0,4,0"
                                    Cursor="Hand" />

                            <Button Content="المنجز"
                                    Command="{Binding SelectFilterTabCommand}"
                                    CommandParameter="Completed"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="14,6"
                                    Margin="0,0,4,0"
                                    Cursor="Hand" />

                            <Button Content="كل الطلاب"
                                    Command="{Binding SelectFilterTabCommand}"
                                    CommandParameter="All"
                                    Style="{StaticResource AppQuietButton}"
                                    Padding="14,6"
                                    Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Centered Student Cards List (3 on default, 4 on wide displays) -->
            <Grid Grid.Row="3" HorizontalAlignment="Center">
                <ItemsControl ItemsSource="{Binding DisplayedStudents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StudentCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Student Info Row -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="#141B524A" DockPanel.Dock="Right" Margin="0,0,10,0">
                                            <controls:AppIcon Kind="AccountEditOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StudentName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                            <TextBlock Text="{Binding HalaqaName}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Plan Targets: show only task types configured in the student's plan -->
                                    <Border Grid.Row="1" Background="#0A000000" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                                        <WrapPanel HorizontalAlignment="Center">
                                            <StackPanel Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0">
                                                <TextBlock Text="حفظ" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentMemorizationPage, StringFormat=ص {0}}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0">
                                                <TextBlock Text="مراجعة" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentReviewPage, StringFormat=ص {0}}" FontSize="12" FontWeight="Bold" Foreground="#FF995C00" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="8,0">
                                                <TextBlock Text="سرد" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding CurrentRecitationPage, StringFormat=ص {0}}" FontSize="12" FontWeight="Bold" Foreground="#FF007799" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Border>

                                    <!-- Attendance & Status -->
                                    <DockPanel Grid.Row="2" Margin="0,0,0,12" LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:AppIcon Kind="CalendarCheckOutline" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding AttendanceFrom, StringFormat=موعد: {0}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding LastEvaluation}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppSuccessBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <!-- Plan actions: one button per configured task type -->
                                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.StartMemorizationRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasMemorizationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppPrimaryButton}"
                                                Padding="8,6" Margin="2,0"
                                                ToolTip="فتح المصحف وبدء جلسة تسميع الحفظ">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Kind="BookOpenPageVariantOutline" Foreground="White" FontSize="14" Margin="0,0,4,0" />
                                                <TextBlock Text="حفظ" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.StartReviewRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasReviewPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppQuietButton}"
                                                Padding="8,6" Margin="2,0"
                                                ToolTip="فتح المصحف وبدء جلسة تسميع المراجعة">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Kind="Replay" Foreground="{StaticResource AppPrimaryBrush}" FontSize="14" Margin="0,0,4,0" />
                                                <TextBlock Text="مراجعة" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.StartSardRecitationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasRecitationPlan, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource AppOutlinedButton}"
                                                Padding="8,6" Margin="2,0"
                                                ToolTip="فتح المصحف وبدء جلسة تسميع السرد والتلاوة">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:AppIcon Kind="Microphone" Foreground="{StaticResource AppInkBrush}" FontSize="14" Margin="0,0,4,0" />
                                                <TextBlock Text="سرد" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
