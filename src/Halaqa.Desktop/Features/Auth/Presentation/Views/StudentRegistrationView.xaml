<UserControl x:Class="Halaqa.Desktop.Features.Auth.Presentation.Views.StudentRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Image Source="/Assets/Images/TagAlwaqar/open-mushaf.jpg" Stretch="UniformToFill" />
        <Rectangle Fill="{StaticResource AppHeroOverlayBrush}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource AppElevatedCard}"
                    Background="{StaticResource AppGlassStrongBrush}"
                    BorderBrush="{StaticResource AppGlassBorderBrush}"
                    Effect="{StaticResource AppSoftShadow}"
                    MaxWidth="820"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="إنشاء حساب طالب" Style="{StaticResource DisplayTitle}" />
                        <TextBlock Text="أكمل البيانات المطلوبة خطوةً بخطوة، ثم راجع طلبك قبل إرساله." Style="{StaticResource BodyMuted}" Margin="0,4,0,14" />
                        <ProgressBar Minimum="1" Maximum="3" Value="{Binding Step}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,28,0,20">
                        <StackPanel Visibility="{Binding IsFirstStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="بيانات الحساب والتواصل" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الاسم الكامل" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الكامل" />
                                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="name@example.com" />
                                    <TextBlock Text="كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="كلمة المرور" />
                                    <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordConfirmationInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="تأكيد كلمة المرور" />
                                    <TextBlock Text="الجنس" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Genders}"
                                              SelectedValue="{Binding Gender}"
                                              SelectedValuePath="Value"
                                              ToolTip="الجنس">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ الميلاد" Style="{StaticResource CaptionText}" />
                                    <DatePicker SelectedDate="{Binding BirthDate}" SelectedDateFormat="Short" Language="ar-SA" ToolTip="اختر تاريخ الميلاد" Validation.Error="BirthDateValidationError" />
                                    <TextBlock Text="الدولة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedCountry}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="NameAr"
                                              ToolTip="اختر أو ابحث عن الدولة">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock Text="{Binding PhoneCode}" DockPanel.Dock="Left" Foreground="{StaticResource AppMutedInkBrush}" FontSize="11" Margin="8,0,0,0" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding FlagImagePath}" Width="20" Height="14" Stretch="UniformToFill" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,20,14" RadiusX="2" RadiusY="2" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <TextBlock Text="{Binding NameAr}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="المدينة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding City}" ToolTip="المدينة" />
                                    <TextBlock Text="مفتاح الدولة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedPhoneZoneCountry}"
                                              Text="{Binding PhoneZone, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="PhoneCode"
                                              ToolTip="اختر أو اكتب مفتاح الدولة مثل +966">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock Text="{Binding NameAr}" DockPanel.Dock="Left" Foreground="{StaticResource AppMutedInkBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding FlagImagePath}" Width="18" Height="13" Stretch="UniformToFill" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,18,13" RadiusX="2" RadiusY="2" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <TextBlock Text="{Binding PhoneCode}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="رقم الهاتف" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Phone}" FlowDirection="LeftToRight" ToolTip="رقم الهاتف" />
                                    <TextBlock Text="مفتاح واتساب" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedWhatsappZoneCountry}"
                                              Text="{Binding WhatsappZone, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="PhoneCode"
                                              ToolTip="اختر مفتاح واتساب بشكل مستقل">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PhoneCode}" FlowDirection="LeftToRight" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding NameAr}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="رقم واتساب (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding WhatsappPhone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="رقم واتساب" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSecondStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="وقت الحضور" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="المنطقة الزمنية" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding TimezoneOptions}" SelectedItem="{Binding Timezone}" IsEditable="True" IsTextSearchEnabled="True" Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}" ToolTip="اختر المنطقة الزمنية أو اكتبها مثل Asia/Riyadh" />
                                    <TextBlock Text="يوم الحضور" Style="{StaticResource CaptionText}" />
                                    <ComboBox SelectedValue="{Binding AttendanceDay}" SelectedValuePath="Tag" ToolTip="يوم الأسبوع">
                                        <ComboBoxItem Content="الأحد" Tag="0" /><ComboBoxItem Content="الاثنين" Tag="1" /><ComboBoxItem Content="الثلاثاء" Tag="2" /><ComboBoxItem Content="الأربعاء" Tag="3" /><ComboBoxItem Content="الخميس" Tag="4" /><ComboBoxItem Content="الجمعة" Tag="5" /><ComboBoxItem Content="السبت" Tag="6" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="من" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding AttendanceTimes}" SelectedItem="{Binding AttendanceFrom}" IsEditable="True" Text="{Binding AttendanceFrom, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="اختر وقت البداية" />
                                    <TextBlock Text="إلى" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding AttendanceTimes}" SelectedItem="{Binding AttendanceTo}" IsEditable="True" Text="{Binding AttendanceTo, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="اختر وقت النهاية" />
                                    <TextBlock Text="رمز المعلم (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding TeacherCode}" ToolTip="رمز المعلم" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsThirdStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="خطة المتابعة" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تكرار الخطة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedValue="{Binding Frequency}" SelectedValuePath="Value" DisplayMemberPath="Label" ToolTip="التكرار" />
                                    <TextBlock Text="نوع المهمة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding TaskTypes}" SelectedValue="{Binding TaskType}" SelectedValuePath="Value" DisplayMemberPath="Label" ToolTip="نوع المهمة" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="وحدة الخطة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding PlanUnits}" SelectedValue="{Binding PlanUnit}" SelectedValuePath="Value" DisplayMemberPath="Label" ToolTip="وحدة الخطة" />
                                    <TextBlock Text="الكمية" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding PlanAmount}" FlowDirection="LeftToRight" ToolTip="الكمية" />
                                </StackPanel>
                            </Grid>
                            <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="3" Padding="12" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"><Run Text="الخطوة " /><Run Text="{Binding Step}" /><Run Text=" من 3" /></TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="السابق" Command="{Binding PreviousCommand}" Style="{StaticResource AppSecondaryButton}" />
                            <Button Content="التالي" Command="{Binding NextCommand}" Style="{StaticResource AppQuietButton}" />
                            <Button Content="إنشاء الحساب" Command="{Binding SubmitCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
