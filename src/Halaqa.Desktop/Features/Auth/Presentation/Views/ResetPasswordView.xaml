<UserControl x:Class="Halaqa.Desktop.Features.Auth.Presentation.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppCard}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <materialDesign:PackIcon Kind="LockReset" Width="42" Height="42" Foreground="{StaticResource AppPrimaryBrush}" />
                <TextBlock Text="إعادة تعيين كلمة المرور" Style="{StaticResource PageTitle}" Margin="0,12,0,4" />
                <TextBlock Text="أدخل الرمز الذي وصل إلى بريدك الإلكتروني، ثم اختر كلمة مرور جديدة." Style="{StaticResource BodyMuted}" Margin="0,0,0,16" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" materialDesign:HintAssist.Hint="البريد الإلكتروني" />
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" materialDesign:HintAssist.Hint="رمز إعادة التعيين" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" materialDesign:HintAssist.Hint="كلمة المرور الجديدة" />
                <PasswordBox x:Name="PasswordConfirmationInput" PasswordChanged="PasswordChanged" materialDesign:HintAssist.Hint="تأكيد كلمة المرور الجديدة" />
                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Button Content="حفظ كلمة المرور الجديدة" Command="{Binding SubmitCommand}" Margin="0,16,0,0" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
