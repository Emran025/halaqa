<UserControl x:Class="Halaqa.Desktop.Features.Auth.Presentation.Views.TeacherRegistrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Image Source="/Assets/Images/TagAlwaqar/study-rehal.jpg" Stretch="UniformToFill" />
        <Rectangle Fill="{StaticResource AppHeroOverlayBrush}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource AppElevatedCard}"
                    Background="{StaticResource AppGlassStrongBrush}"
                    BorderBrush="{StaticResource AppGlassBorderBrush}"
                    Effect="{StaticResource AppSoftShadow}"
                    MaxWidth="820"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="إنشاء حساب معلم" Style="{StaticResource DisplayTitle}" />
                        <TextBlock Text="أكمل بياناتك المهنية لتبدأ إدارة حلقاتك من مكان واحد." Style="{StaticResource BodyMuted}" Margin="0,4,0,18" />
                        <ProgressBar Minimum="1" Maximum="2" Value="{Binding Step}" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,28,0,20">
                        <StackPanel Visibility="{Binding IsFirstStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="بيانات الحساب والتواصل" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الاسم الكامل" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الكامل" />
                                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="name@example.com" />
                                    <TextBlock Text="كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="كلمة المرور" />
                                    <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordConfirmationInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="تأكيد كلمة المرور" />
                                    <TextBlock Text="الجنس" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}" ToolTip="الجنس" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ الميلاد" Style="{StaticResource CaptionText}" />
                                    <DatePicker SelectedDate="{Binding BirthDate}" />
                                    <TextBlock Text="الدولة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" ToolTip="الدولة" />
                                    <TextBlock Text="المدينة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" ToolTip="المدينة" />
                                    <TextBlock Text="مفتاح الدولة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding PhoneZone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="مثل +966" />
                                    <TextBlock Text="رقم الهاتف" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="رقم الهاتف" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSecondStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="البيانات المهنية" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="المؤهل أو الإجازة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Qualification, UpdateSourceTrigger=PropertyChanged}" ToolTip="المؤهل أو الإجازة" />
                                    <TextBlock Text="سنوات الخبرة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ExperienceYears, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="سنوات الخبرة" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="أوقات التوفر" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding AvailableTime, UpdateSourceTrigger=PropertyChanged}" ToolTip="اختياري" />
                                    <TextBlock Text="الحد الأقصى للحلقات" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding MaxHalaqas, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="اختياري" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="نبذة تعريفية" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="104" VerticalContentAlignment="Top" ToolTip="نبذة تعريفية اختيارية" />
                            <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="3" Padding="12" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"><Run Text="الخطوة " /><Run Text="{Binding Step}" /><Run Text=" من 2" /></TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="السابق" Command="{Binding PreviousCommand}" Style="{StaticResource AppSecondaryButton}" />
                            <Button Content="التالي" Command="{Binding NextCommand}" Style="{StaticResource AppQuietButton}" />
                            <Button Content="إنشاء الحساب" Command="{Binding SubmitCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
