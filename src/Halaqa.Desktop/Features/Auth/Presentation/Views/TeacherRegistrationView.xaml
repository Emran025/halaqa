<UserControl x:Class="Halaqa.Desktop.Features.Auth.Presentation.Views.TeacherRegistrationView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
              FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Image Source="/Assets/Images/TagAlwaqar/study-rehal.jpg" Stretch="UniformToFill" />
        <Rectangle Fill="{StaticResource AppHeroOverlayBrush}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource AppElevatedCard}"
                    Background="{StaticResource AppGlassStrongBrush}"
                    BorderBrush="{StaticResource AppGlassBorderBrush}"
                    Effect="{StaticResource AppSoftShadow}"
                    MaxWidth="820"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="إنشاء حساب معلم" Style="{StaticResource DisplayTitle}" />
                        <TextBlock Text="أكمل بياناتك المهنية لتبدأ إدارة حلقاتك من مكان واحد." Style="{StaticResource BodyMuted}" Margin="0,4,0,14" />
                        <ProgressBar Minimum="1" Maximum="2" Value="{Binding Step}" Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,28,0,20">
                        <StackPanel Visibility="{Binding IsFirstStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="بيانات الحساب والتواصل" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الاسم الكامل" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="الاسم الكامل" />
                                    <TextBlock Text="البريد الإلكتروني" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="name@example.com" />
                                    <TextBlock Text="كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="كلمة المرور" />
                                    <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource CaptionText}" />
                                    <PasswordBox x:Name="PasswordConfirmationInput" PasswordChanged="PasswordChanged" FlowDirection="LeftToRight" ToolTip="تأكيد كلمة المرور" />
                                    <TextBlock Text="الجنس" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Genders}"
                                              SelectedValue="{Binding Gender}"
                                              SelectedValuePath="Value"
                                              ToolTip="الجنس">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ الميلاد" Style="{StaticResource CaptionText}" />
                                    <DatePicker SelectedDate="{Binding BirthDate}" />
                                    <TextBlock Text="الدولة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedCountry}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="NameAr"
                                              ToolTip="اختر أو ابحث عن الدولة">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock Text="{Binding PhoneCode}" DockPanel.Dock="Left" Foreground="{StaticResource AppMutedInkBrush}" FontSize="11" Margin="8,0,0,0" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding FlagImagePath}" Width="20" Height="14" Stretch="UniformToFill" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,20,14" RadiusX="2" RadiusY="2" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <TextBlock Text="{Binding NameAr}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="المدينة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" ToolTip="المدينة" />
                                    <TextBlock Text="مفتاح الدولة" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedPhoneZoneCountry}"
                                              Text="{Binding PhoneZone, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="PhoneCode"
                                              ToolTip="اختر أو اكتب مفتاح الدولة مثل +966">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock Text="{Binding NameAr}" DockPanel.Dock="Left" Foreground="{StaticResource AppMutedInkBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding FlagImagePath}" Width="18" Height="13" Stretch="UniformToFill" Margin="0,0,6,0" VerticalAlignment="Center">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,18,13" RadiusX="2" RadiusY="2" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <TextBlock Text="{Binding PhoneCode}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="رقم الهاتف" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="رقم الهاتف" />
                                    <TextBlock Text="مفتاح واتساب" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding Countries}"
                                              SelectedItem="{Binding SelectedWhatsappZoneCountry}"
                                              Text="{Binding WhatsappZone, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="PhoneCode"
                                              ToolTip="اختر مفتاح واتساب بشكل مستقل">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PhoneCode}" FlowDirection="LeftToRight" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding NameAr}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="رقم واتساب (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding WhatsappPhone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="رقم واتساب" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsSecondStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="البيانات المهنية" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="درجة أو نوع التعليم" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding QualificationOptions}"
                                              SelectedValue="{Binding Qualification}"
                                              SelectedValuePath="Value"
                                              DisplayMemberPath="Label"
                                              ToolTip="اختر درجة أو نوع التعليم" />
                                    <TextBlock Text="سنوات الخبرة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ExperienceYears, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="سنوات الخبرة — رقم من 0 إلى 80" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="وقت التوفر (اختياري)" Style="{StaticResource CaptionText}" />
                                    <controls:TimePicker Value="{Binding AvailableTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="الحد الأقصى للحلقات" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding MaxHalaqas, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" ToolTip="اختياري — رقم صحيح" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="نبذة تعريفية" Style="{StaticResource CaptionText}" />
                            <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="104" VerticalContentAlignment="Top" ToolTip="نبذة تعريفية اختيارية" />
                            <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="3" Padding="12" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"><Run Text="الخطوة " /><Run Text="{Binding Step}" /><Run Text=" من 2" /></TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="السابق" Command="{Binding PreviousCommand}" Style="{StaticResource AppSecondaryButton}" />
                            <Button Content="التالي" Command="{Binding NextCommand}" Style="{StaticResource AppQuietButton}" />
                            <Button Content="إنشاء الحساب" Command="{Binding SubmitCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
