<UserControl x:Class="Halaqa.Desktop.Features.TeacherDocuments.Presentation.Views.TeacherDocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="SectionError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <!-- Main Browsing View -->
        <Border Style="{StaticResource AppElevatedCard}" MaxWidth="960" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header Bar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى لوحة التحكم" Style="{StaticResource AppBackButton}">
                        <controls:AppIcon Kind="ArrowRight" />
                    </Button>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Content="+ إضافة وثيقة / مؤهل" Command="{Binding OpenUploadDialogCommand}" Margin="0,0,12,0" />
                        <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppSecondaryButton}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة وثائق ومؤهلات المعلم" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Total, StringFormat=إجمالي الوثائق المرفوعة: {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Documents List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <ProgressBar Height="4" Margin="0,0,0,12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Background="{StaticResource AppInfoSoftBrush}" BorderBrush="#332367C9" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding Documents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,8" Background="{StaticResource AppSurfaceBrush}">
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Left" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="حذف الوثيقة" Style="{StaticResource AppDangerButton}" VerticalAlignment="Center">
                                                <controls:AppIcon Kind="DeleteOutline" />
                                            </Button>
                                            <controls:AppIcon Kind="FileCertificateOutline" DockPanel.Dock="Right" Width="26" Height="26" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding CertificateType, StringFormat=النوع: {0}}" Style="{StaticResource BodyMuted}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding Riwayah, StringFormat=الرواية: {0}}" Style="{StaticResource BodyMuted}" Margin="0,0,16,0" Visibility="{Binding Riwayah, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding IssuingPlace, StringFormat=جهة الإصدار: {0}}" Style="{StaticResource CaptionText}" Margin="0,0,16,0" Visibility="{Binding IssuingPlace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding IssuingDate, StringFormat=تاريخ الإصدار: {0}}" Style="{StaticResource CaptionText}" Visibility="{Binding IssuingDate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Pagination -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppSecondaryButton}" />
                    <TextBlock Text="{Binding CurrentPage, StringFormat=الصفحة {0}}" VerticalAlignment="Center" Margin="16,0" FontWeight="SemiBold" />
                    <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppSecondaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Overlay Dialog for Uploading Document -->
        <Grid Background="#7F000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource AppElevatedCard}" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Background="{StaticResource AppSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Left" Command="{Binding CloseDialogCommand}" ToolTip="إغلاق">
                            <controls:AppIcon Kind="Close" />
                        </Button>
                        <TextBlock Text="إرفاق وثيقة أو مؤهل جديد" Style="{StaticResource PageTitle}" FontSize="18" />
                    </DockPanel>

                    <!-- Dialog Form -->
                    <ScrollViewer Grid.Row="1" MaxHeight="450" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ProgressBar Height="4" Margin="0,0,0,12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="اسم الوثيقة *" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="اسم الوثيقة" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding NameError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="نوع الشهادة أو الوثيقة *" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding CertificateType, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="نوع الشهادة" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding CertificateTypeError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="نوع آخر (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding CertificateTypeOther, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="نوع آخر" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding CertificateTypeOtherError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="الرواية (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Riwayah, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الرواية" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding RiwayahError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="جهة الإصدار (اختياري)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding IssuingPlace, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="جهة الإصدار" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding IssuingPlaceError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="تاريخ الإصدار (YYYY-MM-DD)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding IssuingDate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="تاريخ الإصدار" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding IssuingDateError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#0A000000" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,8,0,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="اختيار ملف الوثيقة" Command="{Binding ChooseFileCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                    <TextBlock Text="{Binding SelectedFileName, TargetNullValue=لم يتم اختيار ملف بعد}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight" Margin="10,0,0,0" FontWeight="SemiBold" />
                                </DockPanel>
                            </Border>
                            <TextBlock Text="{Binding FileError}" Style="{StaticResource SectionError}" />

                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding IsError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Actions -->
                    <DockPanel Grid.Row="2" Margin="0,16,0,0">
                        <Button DockPanel.Dock="Left" Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource AppSecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="رفع وحفظ الوثيقة" Command="{Binding SaveCommand}" HorizontalAlignment="Right" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
