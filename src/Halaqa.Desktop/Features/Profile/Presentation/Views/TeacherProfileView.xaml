<UserControl x:Class="Halaqa.Desktop.Features.Profile.Presentation.Views.TeacherProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="SectionError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppElevatedCard}"
                MaxWidth="980"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى لوحة التحكم">
                        <controls:AppIcon Kind="ArrowRight"  />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="الملف التفصيلي للمعلم" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="تُحمّل البيانات المهنية والاتصال الرسمية من الخادم. الوثائق للعرض فقط في هذه الشاشة." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <StackPanel>
                        <ProgressBar Height="4" Margin="0,0,0,12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBlock Text="الهوية المهنية" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الاسم المعروض" />
                                <TextBlock Text="{Binding NameError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding TeacherCode}" IsReadOnly="True" FlowDirection="LeftToRight" ToolTip="رمز المعلم" />
                                <TextBox Text="{Binding Qualification, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="المؤهل" />
                                <CheckBox Content="مسح المؤهل" IsChecked="{Binding ClearQualification}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding QualificationError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Text="{Binding Email}" IsReadOnly="True" FlowDirection="LeftToRight" ToolTip="البريد الإلكتروني" />
                                <TextBox Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="تاريخ الميلاد (YYYY-MM-DD)" />
                                <CheckBox Content="مسح تاريخ الميلاد" IsChecked="{Binding ClearBirthDate}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding BirthDateError}" Style="{StaticResource SectionError}" />
                                <ComboBox ItemsSource="{Binding GenderOptions}" SelectedValue="{Binding Gender}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" ToolTip="الجنس" />
                                <CheckBox Content="مسح الجنس" IsChecked="{Binding ClearGender}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding GenderError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="الموقع والتواصل" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الدولة" />
                                <CheckBox Content="مسح الدولة" IsChecked="{Binding ClearCountry}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding CountryError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="المدينة" />
                                <CheckBox Content="مسح المدينة" IsChecked="{Binding ClearCity}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding CityError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding Residence, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="محل الإقامة" />
                                <CheckBox Content="مسح محل الإقامة" IsChecked="{Binding ClearResidence}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding ResidenceError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رقم الهاتف" />
                                <CheckBox Content="مسح رقم الهاتف" IsChecked="{Binding ClearPhone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding PhoneError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding PhoneZone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رمز الهاتف" />
                                <CheckBox Content="مسح رمز الهاتف" IsChecked="{Binding ClearPhoneZone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding PhoneZoneError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding WhatsappPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رقم واتساب" />
                                <CheckBox Content="مسح رقم واتساب" IsChecked="{Binding ClearWhatsappPhone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding WhatsappPhoneError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding WhatsappZone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رمز واتساب" />
                                <CheckBox Content="مسح رمز واتساب" IsChecked="{Binding ClearWhatsappZone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding WhatsappZoneError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="التوافر والخبرة" Style="{StaticResource SectionHeading}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBox Text="{Binding ExperienceYears, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="سنوات الخبرة" />
                                <CheckBox Content="مسح سنوات الخبرة" IsChecked="{Binding ClearExperienceYears}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding ExperienceYearsError}" Style="{StaticResource SectionError}" />
                                <TextBox Text="{Binding AvailableTime, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الأوقات المتاحة" />
                                <CheckBox Content="مسح الأوقات المتاحة" IsChecked="{Binding ClearAvailableTime}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding AvailableTimeError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <Border Background="#0D155EEF" CornerRadius="4" Padding="12" Margin="0,4,0,12">
                                    <StackPanel>
                                        <TextBlock Text="حالة السعة" Style="{StaticResource BodyMuted}" />
                                        <TextBlock Text="{Binding CapacityAvailable, StringFormat=متاحة: {0}}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="{Binding ActiveHalaqaCount, StringFormat=الحلقات النشطة: {0}}" Style="{StaticResource BodyMuted}" />
                                    </StackPanel>
                                </Border>
                                <TextBox Text="{Binding MaxHalaqas, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="الحد الأقصى للحلقات" />
                                <CheckBox Content="مسح الحد الأقصى للحلقات" IsChecked="{Binding ClearMaxHalaqas}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                                <TextBlock Text="{Binding MaxHalaqasError}" Style="{StaticResource SectionError}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="التعريف المختصر" Style="{StaticResource SectionHeading}" />
                        <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" ToolTip="التعريف المختصر" />
                        <CheckBox Content="مسح التعريف المختصر" IsChecked="{Binding ClearBio}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        <TextBlock Text="{Binding BioError}" Style="{StaticResource SectionError}" />

                        <TextBlock Text="وثائق المعلم" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="الوثائق ظاهرة للقراءة فقط في هذه الملخصات؛ استخدم الإدارة لإرفاق وثيقة أو حذفها." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="إدارة الوثائق" Command="{Binding OpenDocumentsCommand}" HorizontalAlignment="Right" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Documents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,3">
                                        <DockPanel>
                                            <controls:AppIcon Kind="FileCertificateOutline" Width="20" Height="20" Foreground="{StaticResource AppInfoBrush}" Margin="0,0,8,0"  />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CertificateType}" Style="{StaticResource BodyMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                    <Button Content="إعادة تحميل البيانات" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                    <Button Content="حفظ التغييرات" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
