<UserControl x:Class="Halaqa.Desktop.Features.Profile.Presentation.Views.TeacherProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="SectionError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- READ-ONLY / DISPLAY MODE (وضع القراءة) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1050" Margin="28,24" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Action Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Right Side (Column 0 in RTL = visual Right): Back Button + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackCommand}"
                                Style="{StaticResource AppBackButton}"
                                ToolTip="العودة للوحة التحكم"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <controls:AppIcon Kind="ArrowRight" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="الملف المهني للمعلم" Style="{StaticResource DisplayTitle}" />
                            <TextBlock Text="استعرض بياناتك المهنية والاتصال الرسمية وروايات الإجازة، أو عدّلها بسهولة عبر زر التعديل." Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Left Side (Column 1 in RTL = visual Left): Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding LoadCommand}"
                                Style="{StaticResource AppQuietButton}"
                                Padding="10,8" Margin="0,0,8,0"
                                ToolTip="تحديث بيانات الملف">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="Refresh" FontSize="15" Margin="0,0,4,0" />
                                <TextBlock Text="تحديث" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenDocumentsCommand}"
                                Style="{StaticResource AppQuietButton}"
                                Padding="10,8" Margin="0,0,8,0"
                                ToolTip="إدارة وثائق المعلم">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="FileCertificateOutline" FontSize="15" Margin="0,0,4,0" />
                                <TextBlock Text="إدارة الوثائق" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenEditDialogCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Padding="14,8"
                                ToolTip="تعديل بيانات الملف المهني">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="AccountEditOutline" Foreground="White" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="تعديل الملف الشخصي" Foreground="White" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Feedback Banner & Progress -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,10"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Background="#121B524A" BorderBrush="#331B524A" BorderThickness="1" CornerRadius="6" Padding="14,10"
                            Visibility="{Binding Message, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                    </Border>
                </StackPanel>

                <!-- Read-Only Profile Content -->
                <StackPanel Grid.Row="2">
                    <!-- Profile Overview Card -->
                    <Border Style="{StaticResource AppCard}" Padding="24,20" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Avatar -->
                            <Border Grid.Column="0" Width="80" Height="80" CornerRadius="40"
                                    Background="#141B524A" BorderBrush="{StaticResource AppPrimaryBrush}" BorderThickness="2">
                                <controls:AppIcon Kind="AccountTieOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="40"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                    <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TeacherCode, StringFormat=رمز المعلم: {0}}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#10155EEF" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Qualification, FallbackValue=معلم قرآن}" FontSize="11" Foreground="{StaticResource AppInfoBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#101F7A4D" CornerRadius="4" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CapacityDisplay}" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:AppIcon Kind="EmailOutline" FontSize="14" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Email}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:AppIcon Kind="PhoneOutline" FontSize="14" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding PhoneDisplay}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" FlowDirection="LeftToRight" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                        <controls:AppIcon Kind="MapMarkerOutline" FontSize="14" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding LocationDisplay}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3 Organized Information Cards -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Identity & Professional Details -->
                        <Border Grid.Column="0" Style="{StaticResource AppCard}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <controls:AppIcon Kind="CardAccountDetailsOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="الهوية المهنية والاتصال" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AppInkBrush}" />
                                </StackPanel>

                                <TextBlock Text="الاسم المعروض" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,10" />

                                <TextBlock Text="رمز المعلم" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding TeacherCode}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,10" />

                                <TextBlock Text="المؤهل العلمي" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Qualification, FallbackValue=غير محدد}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10" />

                                <TextBlock Text="البريد الإلكتروني" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Email}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,10" />

                                <TextBlock Text="رقم الهاتف" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding PhoneDisplay}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,10" />

                                <TextBlock Text="رقم الواتساب" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding WhatsappDisplay}" FontSize="12" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,10" />

                                <TextBlock Text="الجنس وتاريخ الميلاد" Style="{StaticResource CaptionText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                    <TextBlock Text="{Binding GenderDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding BirthDate, FallbackValue=غير محدد, StringFormat=({0})}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding AgeDisplay}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>

                                <TextBlock Text="الدولة ومحل الإقامة" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding LocationDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Experience & Bio -->
                        <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <controls:AppIcon Kind="BriefcaseOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="الخبرة والتوافر والنبذة" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AppInkBrush}" />
                                </StackPanel>

                                <TextBlock Text="سنوات الخبرة التعليمية" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ExperienceDisplay}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,10" />

                                <TextBlock Text="الأوقات المتاحة للتدريس" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding AvailableTime, FallbackValue=غير محدد}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10" TextWrapping="Wrap" />

                                <TextBlock Text="حالة استقبال الطلاب" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding CapacityDisplay}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10" />

                                <TextBlock Text="عدد الحلقات النشطة" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding ActiveHalaqaCount, StringFormat={}{0} حلقات}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,10" />

                                <TextBlock Text="التعريف والنبذة المهنية" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding Bio, FallbackValue=لا توجد نبذة مضافة}" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Documents & Halaqas -->
                        <Border Grid.Column="4" Style="{StaticResource AppCard}" Padding="18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <controls:AppIcon Kind="CertificateOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" Margin="0,0,6,0" />
                                    <TextBlock Text="الوثائق والشهادات المعتمدة" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AppInkBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6" Background="#06000000">
                                                <DockPanel LastChildFill="True">
                                                    <controls:AppIcon Kind="FileCertificateOutline" DockPanel.Dock="Left" Width="18" Height="18" Foreground="{StaticResource AppInfoBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding CertificateType}" Style="{StaticResource BodyMuted}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="الحلقات التابعة للمعلم" Style="{StaticResource CaptionText}" Margin="0,12,0,6" />
                                <ItemsControl ItemsSource="{Binding PublicHalaqas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#14000000" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4" Background="#061B524A">
                                                <DockPanel LastChildFill="True">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding AvailableCapacity, StringFormat=المتبقي: {0}}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- EDIT MODAL DIALOG OVERLAY (نافذة التعديل المنبثقة بعرض الشاشة) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Background="#990B1317"
              Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource AppElevatedCard}"
                    Width="900"
                    MaxWidth="960"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <controls:AppIcon Kind="AccountEditOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="22" Margin="0,0,8,0" />
                                <TextBlock Text="تعديل الملف المهني للمعلم" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                            </StackPanel>
                            <TextBlock Text="عدّل البيانات المهنية وبيانات الاتصال والخبرة ثم احفظ التعديلات." Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding CloseEditDialogCommand}"
                                Style="{StaticResource AppQuietButton}" Padding="8" ToolTip="إغلاق النافذة">
                            <controls:AppIcon Kind="Close" FontSize="16" />
                        </Button>
                    </DockPanel>

                    <!-- Dialog Body (Scrollable Form) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,16" Padding="0,0,8,0">
                        <StackPanel>
                            <ProgressBar Height="4" Margin="0,0,0,12" IsIndeterminate="True"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Section 1: Professional Identity -->
                            <TextBlock Text="الهوية المهنية" Style="{StaticResource SectionHeading}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الاسم المعروض" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الاسم المعروض" />
                                    <TextBlock Text="{Binding NameError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="المؤهل العلمي" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Qualification, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="المؤهل" />
                                    <CheckBox Content="مسح المؤهل" IsChecked="{Binding ClearQualification}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding QualificationError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="رمز المعلم (للقراءة فقط)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding TeacherCode}" IsReadOnly="True" FlowDirection="LeftToRight" ToolTip="رمز المعلم" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="البريد الإلكتروني (للقراءة فقط)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Email}" IsReadOnly="True" FlowDirection="LeftToRight" ToolTip="البريد الإلكتروني" />

                                    <TextBlock Text="تاريخ الميلاد (YYYY-MM-DD)" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding BirthDate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="تاريخ الميلاد (YYYY-MM-DD)" />
                                    <CheckBox Content="مسح تاريخ الميلاد" IsChecked="{Binding ClearBirthDate}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding BirthDateError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="الجنس" Style="{StaticResource CaptionText}" />
                                    <ComboBox ItemsSource="{Binding GenderOptions}" SelectedValue="{Binding Gender}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" ToolTip="الجنس" />
                                    <CheckBox Content="مسح الجنس" IsChecked="{Binding ClearGender}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding GenderError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                            </Grid>

                            <!-- Section 2: Location & Contact -->
                            <TextBlock Text="الموقع والتواصل" Style="{StaticResource SectionHeading}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الدولة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الدولة" />
                                    <CheckBox Content="مسح الدولة" IsChecked="{Binding ClearCountry}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CountryError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="المدينة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="المدينة" />
                                    <CheckBox Content="مسح المدينة" IsChecked="{Binding ClearCity}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding CityError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="محل الإقامة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Residence, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="محل الإقامة" />
                                    <CheckBox Content="مسح محل الإقامة" IsChecked="{Binding ClearResidence}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ResidenceError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="رقم الهاتف" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رقم الهاتف" />
                                    <CheckBox Content="مسح رقم الهاتف" IsChecked="{Binding ClearPhone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding PhoneError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="رمز الهاتف (مثال: +966)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding PhoneZone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رمز الهاتف" />
                                    <CheckBox Content="مسح رمز الهاتف" IsChecked="{Binding ClearPhoneZone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding PhoneZoneError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="رقم واتساب" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding WhatsappPhone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رقم واتساب" />
                                    <CheckBox Content="مسح رقم واتساب" IsChecked="{Binding ClearWhatsappPhone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding WhatsappPhoneError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="رمز واتساب (مثال: +966)" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding WhatsappZone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="رمز واتساب" />
                                    <CheckBox Content="مسح رمز واتساب" IsChecked="{Binding ClearWhatsappZone}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding WhatsappZoneError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                            </Grid>

                            <!-- Section 3: Availability & Experience -->
                            <TextBlock Text="التوافر والخبرة" Style="{StaticResource SectionHeading}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سنوات الخبرة" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding ExperienceYears, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="سنوات الخبرة" />
                                    <CheckBox Content="مسح سنوات الخبرة" IsChecked="{Binding ClearExperienceYears}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding ExperienceYearsError}" Style="{StaticResource SectionError}" />

                                    <TextBlock Text="الأوقات المتاحة للتدريس" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding AvailableTime, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الأوقات المتاحة" />
                                    <CheckBox Content="مسح الأوقات المتاحة" IsChecked="{Binding ClearAvailableTime}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding AvailableTimeError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الحد الأقصى للحلقات" Style="{StaticResource CaptionText}" />
                                    <TextBox Text="{Binding MaxHalaqas, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="الحد الأقصى للحلقات" />
                                    <CheckBox Content="مسح الحد الأقصى للحلقات" IsChecked="{Binding ClearMaxHalaqas}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding MaxHalaqasError}" Style="{StaticResource SectionError}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="التعريف المختصر والنبذة" Style="{StaticResource SectionHeading}" />
                            <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" ToolTip="التعريف المختصر" />
                            <CheckBox Content="مسح التعريف المختصر" IsChecked="{Binding ClearBio}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding BioError}" Style="{StaticResource SectionError}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Footer -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="حفظ التعديلات" Command="{Binding SaveCommand}" Style="{StaticResource AppPrimaryButton}" Padding="16,8" Margin="0,0,8,0" />
                            <Button Content="إلغاء" Command="{Binding CloseEditDialogCommand}" Style="{StaticResource AppQuietButton}" Padding="14,8" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
