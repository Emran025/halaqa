<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.StudentRegistrationRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppCard}" MaxWidth="1080" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى البحث عن معلم">
                        <controls:AppIcon Kind="ArrowRight"  />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="طلباتي" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="راجع حالة طلبات التسجيل الخاصة بك. لا يمكن سحب إلا الطلب الذي ما زال معلقاً." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                    <Border Background="#0A000000" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="الطلبات" Style="{StaticResource SectionTitle}" />
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterState}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" Width="160" FlowDirection="LeftToRight" ToolTip="تصفية الحالة" />
                                    <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Total, StringFormat=الإجمالي: {0}}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" Margin="0,12,0,8" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource BodyMuted}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding DecisionNote}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=الصفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="اختر طلباً من القائمة لعرض حالته الحالية. لا تُحذف البيانات من الشاشة محلياً؛ تعاد القائمة من الخادم بعد السحب." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Button Content="سحب الطلب المعلّق" Command="{Binding CancelCommand}" Style="{StaticResource AppDangerButton}" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
                <Button Grid.Row="2" Content="إعادة تحميل طلباتي" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
