<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.StudentRegistrationRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <shared:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <shared:RegistrationStateToTextConverter x:Key="RegistrationStateToTextConverter" />
        <shared:RegistrationStateToBackgroundBrushConverter x:Key="RegistrationStateToBackgroundBrushConverter" />
        <shared:RegistrationStateToForegroundBrushConverter x:Key="RegistrationStateToForegroundBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <!-- Main Full-Screen Layout -->
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة للرئيسية">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="طلبات التسجيل والمتابعة" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="متابعة طلبات الانضمام للحلقات وقرارات المعلمين" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Search & Filter Toolbar Card -->
            <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedValue="{Binding FilterState}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="180" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" />
                        <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}" Style="{StaticResource AppPrimaryButton}" Padding="18,0" Height="36" Margin="0,0,10,0" />
                        <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,0" Height="36" Margin="0,0,10,0" />

                        <!-- Search for new teacher button - visible ONLY when no active or accepted request -->
                        <Button Content="البحث عن معلم جديد" Command="{Binding NewSearchCommand}" Style="{StaticResource AppPrimaryButton}" Padding="16,0" Height="36"
                                Visibility="{Binding CanSearchNewTeacher, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ProgressBar Width="70" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource AppSurfaceMutedBrush}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلبات: {0}}" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Feedback Message Banner (if any) -->
            <Border Grid.Row="1" Background="#121B524A" BorderBrush="#331B524A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,60,0,0" VerticalAlignment="Top" Panel.ZIndex="10"
                    Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
            </Border>

            <!-- Full-Width Requests List Area -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Scrollable Requests -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,10" Background="{StaticResource AppSurfaceBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Column 0: Avatar / Icon (Right in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Column 1: Info (Middle) -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Column 2: Action Button (Left in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Teacher Avatar on Column 0 (Right) -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AppPrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Kind="AccountTie" Foreground="{StaticResource AppPrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Teacher Info & Status in Column 1 (Middle) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding TeacherName, TargetNullValue='طلب موجه لمعلم', FallbackValue='طلب موجه لمعلم'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AppInkBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{Binding State, Converter={StaticResource RegistrationStateToBackgroundBrushConverter}}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State, Converter={StaticResource RegistrationStateToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding State, Converter={StaticResource RegistrationStateToForegroundBrushConverter}}" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Metadata row: Halaqa, Code, Date -->
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding HalaqaName, StringFormat=الحلقة: {0}}" Visibility="{Binding HalaqaName, Converter={StaticResource StringToVisibilityConverter}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding TeacherCode, StringFormat=كود المعلم: {0}}" Visibility="{Binding TeacherCode, Converter={StaticResource StringToVisibilityConverter}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=تاريخ الطلب: {0:yyyy-MM-dd}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" />
                                                </StackPanel>

                                                <!-- Student's Message (if any) -->
                                                <Border Background="#06000000" CornerRadius="4" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                        Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding Message, StringFormat=رسالتك: {0}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppInkBrush}" TextWrapping="Wrap" MaxWidth="600" />
                                                </Border>

                                                <!-- Teacher's Decision Note (if any) -->
                                                <Border Background="#101F7A4D" CornerRadius="4" Padding="8,4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                                        Visibility="{Binding DecisionNote, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding DecisionNote, StringFormat=ملاحظة المعلم: {0}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppSuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="600" />
                                                </Border>
                                            </StackPanel>

                                            <!-- Action Button in Column 2 (Left in RTL) -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <!-- Cancel button for Pending / CompletionRequested -->
                                                <Button Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="16,8">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AppDangerButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Pending">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="CompletionRequested">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Kind="Cancel" Foreground="White" FontSize="13" Margin="0,0,6,0" />
                                                        <TextBlock Text="سحب الطلب" Foreground="White" FontWeight="Bold" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Accepted Notice Badge -->
                                                <Border Background="#121F7A4D" CornerRadius="4" Padding="10,6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Accepted">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Kind="CheckCircleOutline" Foreground="{StaticResource AppSuccessBrush}" FontSize="14" Margin="0,0,4,0" />
                                                        <TextBlock Text="تم القبول — يمكنك الحضور" FontSize="11" Foreground="{StaticResource AppSuccessBrush}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Search for another teacher if Rejected / Withdrawn / Cancelled -->
                                                <Button Command="{Binding DataContext.NewSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Padding="14,8">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource AppOutlinedButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Rejected">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Withdrawn">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:AppIcon Kind="AccountSearchOutline" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="البحث عن معلم آخر" FontSize="11" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasNoRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:AppIcon Kind="ClipboardTextOffOutline" FontSize="48" Foreground="{StaticResource AppBorderBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا توجد طلبات تسجيل في هذا القسم حالياً" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="يمكنك البحث عن معلمين متاحين والتقديم أو تعديل خيارات التصفية أو النقر على تحديث" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <Button Content="تصفح دليل المعلمين والتقديم"
                                Command="{Binding NewSearchCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Padding="18,8" HorizontalAlignment="Center"
                                Visibility="{Binding CanSearchNewTeacher, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلبات: {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AppMutedInkBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
