<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.StudentRegistrationRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </UserControl.Resources>
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppElevatedCard}" MaxWidth="1080" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى البحث عن معلم" Style="{StaticResource AppBackButton}">
                        <controls:AppIcon Kind="ArrowRight" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="طلباتي" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="تابع حالة طلبات التسجيل من البطاقات، ويمكن سحب الطلب المعلّق من بطاقته مباشرة." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding FilterOptions}"
                                  SelectedValue="{Binding FilterState}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                  Width="190"
                                  ToolTip="تصفية الحالة" />
                        <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الطلبات" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Total, StringFormat=الإجمالي: {0}}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Requests}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="320" Margin="0,0,12,12" Padding="14" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Background="#FFFFFFFF">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="{StaticResource AppPrimaryBrush}" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd}}" Style="{StaticResource BodyMuted}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding DecisionNote}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <Button Content="سحب الطلب المعلّق"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AppDangerButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="إعادة تحميل طلباتي" Command="{Binding LoadCommand}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" />
                            <TextBlock Text="{Binding CurrentPage, StringFormat=الصفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                            <Button Content="التالي" Command="{Binding LoadNextPageCommand}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
