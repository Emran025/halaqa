<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.HalaqaRegistrationRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <shared:RegistrationStateToTextConverter x:Key="StateToTextConverter" />
        <shared:RegistrationStateToBackgroundBrushConverter x:Key="StateToBackgroundBrushConverter" />
        <shared:RegistrationStateToForegroundBrushConverter x:Key="StateToForegroundBrushConverter" />
        <shared:VisibilityToTextConverter x:Key="VisibilityToTextConverter" />
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppCanvasBrush}">
        <!-- Main Full-Screen Layout -->
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة إلى إدارة الحلقات">
                    <controls:AppIcon Kind="ArrowRight" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="طلبات التسجيل في الحلقة" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding HalaqaName, StringFormat=الحلقة: {0}}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Search & Filter Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" ToolTip="ابحث باسم المتقدم أو رسالته" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" Padding="8,0" />
                        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedValue="{Binding FilterState}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="180" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" />
                        <Button Content="تطبيق" Command="{Binding ApplyFilterCommand}" Style="{StaticResource AppPrimaryButton}" Padding="18,0" Height="36" Margin="0,0,10,0" />
                        <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,0" Height="36" />
                        <ProgressBar Width="70" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{StaticResource AppSurfaceMutedBrush}" CornerRadius="4" Padding="12,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلبات: {0}}" FontWeight="SemiBold" Foreground="{StaticResource AppInkBrush}" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <!-- Full-Width Requests List Area -->
            <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Scrollable Requests -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Requests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,10" Background="{StaticResource AppSurfaceBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Column 0: Avatar (Right in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                                <!-- Column 1: Info (Middle) -->
                                                <ColumnDefinition Width="*" />
                                                <!-- Column 2: Action Button (Left in RTL) -->
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Student Avatar on Column 0 (Right) -->
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Background="{StaticResource AppPrimarySoftBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Student Info & Message in Column 1 (Middle) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Applicant.DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AppInkBrush}" VerticalAlignment="Center" />
                                                    <Border Background="{Binding State, Converter={StaticResource StateToBackgroundBrushConverter}}" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding State, Converter={StaticResource StateToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding State, Converter={StaticResource StateToForegroundBrushConverter}}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Applicant.SubmittedAt, StringFormat=تاريخ التقديم: {0:yyyy-MM-dd}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,16,0" />
                                                    <TextBlock Text="{Binding Visibility, Converter={StaticResource VisibilityToTextConverter}, StringFormat=نوع الظهور: {0}}" Style="{StaticResource CaptionText}" Foreground="{StaticResource AppMutedInkBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            </StackPanel>

                                            <!-- Action Button in Column 2 (Left) -->
                                            <Button Grid.Column="2" Content="مراجعة الطلب" Command="{Binding DataContext.OpenDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AppPrimaryButton}" Padding="18,8" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50"
                                Visibility="{Binding HasNoRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:AppIcon Kind="AccountClockOutline" FontSize="48" Foreground="{StaticResource AppBorderBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا توجد طلبات تسجيل في هذه الحلقة حالياً" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="يمكنك تغيير خيار التصفية أو النقر على تحديث للتأكد من وصول طلبات جديدة" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,6" />
                            </StackPanel>
                            <TextBlock Text="{Binding Total, StringFormat=إجمالي الطلبات: {0}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource AppMutedInkBrush}" FontSize="12" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay Modal Dialog for Review & Decisions -->
        <Grid Background="#7F000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource AppElevatedCard}" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Background="{StaticResource AppSurfaceBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource PageTitle}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Command="{Binding CloseDialogCommand}" Style="{StaticResource AppBackButton}" ToolTip="إغلاق" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <controls:AppIcon Kind="Close" />
                        </Button>
                    </Grid>

                    <!-- Dialog Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12" />

                            <!-- Applicant Summary Box -->
                            <Border Background="{StaticResource AppSurfaceMutedBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding SelectedRequest.Applicant.DisplayName}" FontWeight="Bold" FontSize="15" />
                                        <Border DockPanel.Dock="Left" Background="{Binding SelectedRequest.State, Converter={StaticResource StateToBackgroundBrushConverter}}" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding SelectedRequest.State, Converter={StaticResource StateToTextConverter}}" FontSize="11" FontWeight="Bold" Foreground="{Binding SelectedRequest.State, Converter={StaticResource StateToForegroundBrushConverter}}" />
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SelectedRequest.Applicant.SubmittedAt, StringFormat=تاريخ التقديم: {0:yyyy-MM-dd HH:mm}}" Style="{StaticResource CaptionText}" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding SelectedRequest.Visibility, Converter={StaticResource VisibilityToTextConverter}, StringFormat=نوع الظهور: {0}}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedRequest.Message, StringFormat=رسالة المتقدم: {0}}" Visibility="{Binding SelectedRequest.Message, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Status Message / Feedback -->
                            <Border Background="{StaticResource AppInfoSoftBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,14" Visibility="{Binding Message, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppInkBrush}" TextWrapping="Wrap" FontSize="12" />
                            </Border>

                            <!-- Case 1: Accepted state - Assign to Halaqa -->
                            <StackPanel Visibility="{Binding IsAcceptedState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="إدخال الطالب إلى هذه الحلقة" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="هذا الطلب مقبول مسبقاً من قِبل المعلم. يمكنك إدخال الطالب وإسناده إلى هذه الحلقة مباشرة ليصبح عضواً نشطاً." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Button Content="إدخال الطالب إلى هذه الحلقة" Command="{Binding AssignToHalaqaCommand}" Style="{StaticResource AppPrimaryButton}" HorizontalAlignment="Left" Padding="18,8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Case 2: Pending or CompletionRequested state -->
                            <StackPanel Visibility="{Binding IsPendingState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Accept & Assign -->
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="قبول الطلب وإدخال الطالب للحلقة" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="قبول طلب التسجيل وإدخال الطالب مباشرة إلى هذه الحلقة كعضو نشط." Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Button Content="قبول وإدخال الطالب إلى الحلقة" Command="{Binding AcceptCommand}" Style="{StaticResource AppPrimaryButton}" HorizontalAlignment="Left" Padding="18,8" />
                                    </StackPanel>
                                </Border>

                                <!-- Reject -->
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="رفض الطلب" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="سبب الرفض (اختياري):" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding RejectionNote, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="54" TextWrapping="Wrap" ToolTip="ملاحظة الرفض" />
                                        <TextBlock Text="{Binding RejectionNoteError}" Style="{StaticResource FieldError}" />
                                        <Button Content="رفض الطلب" Command="{Binding RejectCommand}" Style="{StaticResource AppDangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Request Completion -->
                                <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="طلب استكمال بيانات" Style="{StaticResource SectionTitle}" Margin="0,0,0,4" />
                                        <TextBlock Text="الحقول المطلوب استكمالها (مفصولة بفواصل) *" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding RequiredFields, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="مثال: رقم الهاتف، الدولة، صورة الهوية" Height="36" Padding="8,0" />
                                        <TextBlock Text="{Binding RequiredFieldsError}" Style="{StaticResource FieldError}" />
                                        <TextBlock Text="ملاحظة توضيحية للمتقدم (اختياري):" Style="{StaticResource CaptionText}" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding CompletionNote, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="50" TextWrapping="Wrap" ToolTip="ملاحظة الاستكمال" />
                                        <TextBlock Text="{Binding CompletionNoteError}" Style="{StaticResource FieldError}" />
                                        <Button Content="إرسال طلب الاستكمال" Command="{Binding RequestCompletionCommand}" Style="{StaticResource AppOutlinedButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Dialog Footer -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <Button Content="إغلاق" Command="{Binding CloseDialogCommand}" Style="{StaticResource AppOutlinedButton}" HorizontalAlignment="Left" Padding="18,6" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
