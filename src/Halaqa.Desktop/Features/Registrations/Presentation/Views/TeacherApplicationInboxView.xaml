<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.TeacherApplicationInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
            <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة إلى لوحة التحكم">
                <controls:AppIcon Kind="ArrowRight" />
            </Button>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <TextBlock Text="طلبات الطلاب المتاحة" Style="{StaticResource PageTitle}" />
                <TextBlock Text="يعرض الصندوق الملخص العام للطلبات لمراجعتها واتخاذ قرار القبول أو الرفض أو طلب الاستكمال." Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Full-Width Connection Error / Alert Banner -->
        <Border Grid.Row="1" Margin="0,0,0,16" CornerRadius="8" Padding="16,12" Background="#14DC3545" BorderBrush="#33DC3545" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Command="{Binding LoadCommand}" Style="{StaticResource AppPrimaryButton}" Background="#FFC62828" Foreground="White" Padding="14,6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppIcon Kind="Replay" Foreground="White" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="إعادة المحاولة" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AppIcon Kind="AlertCircleOutline" Foreground="#FFDC3545" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="تنبيه الاتصال بالخادم" FontWeight="Bold" Foreground="#FFDC3545" FontSize="13" />
                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource AppInkBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & Filter Bar -->
        <Border Grid.Row="2" Style="{StaticResource AppCard}" Padding="16,12" Margin="0,0,0,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="ابحث باسم المتقدم" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" Padding="8,0" />
                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedValue="{Binding FilterState}" SelectedValuePath="Value" DisplayMemberPath="Label" Width="200" Margin="0,0,10,0" VerticalAlignment="Center" Height="36" />
                    <Button Content="بحث وتصفية" Command="{Binding ApplyFilterCommand}" Style="{StaticResource AppPrimaryButton}" Padding="16,0" Height="36" Margin="0,0,10,0" />
                    <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource AppOutlinedButton}" Padding="14,0" Height="36" />
                </StackPanel>
                <ProgressBar Width="90" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </DockPanel>
        </Border>

        <!-- Main 2-Column Content Grid -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Requests List -->
            <Border Grid.Column="0" Style="{StaticResource AppCard}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- List of Requests -->
                    <ListBox Grid.Row="0" ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" MinHeight="280" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,12" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="4" Margin="0,0,0,4" Background="#05000000">
                                    <DockPanel LastChildFill="True">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#141B524A" DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Applicant.DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AppInkBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border Background="{StaticResource AppPrimarySoftBrush}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty List State -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40"
                                Visibility="{Binding HasNoRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <controls:AppIcon Kind="AccountClockOutline" FontSize="44" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="لا توجد طلبات تسجيل متاحة حالياً" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="يمكنك تغيير فلتر البحث أو النقر على تحديث للتأكد من وصول طلبات جديدة" FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="12,6" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="12,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" Padding="12,6" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Total, StringFormat=إجمالي الطلبات: {0}}" VerticalAlignment="Center" Foreground="{StaticResource AppMutedInkBrush}" FontSize="12" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Column 1: Review Panel (Left in RTL) -->
            <!-- STATE A: No Request Selected -->
            <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="24"
                    Visibility="{Binding HasNoSelectedRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" Background="#0A000000" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <controls:AppIcon Kind="AccountQuestionOutline" Foreground="{StaticResource AppMutedInkBrush}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="لم يتم اختيار متقدم" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="اختر طلباً من القائمة لعرض تفاصيله ورسالته واتخاذ إجراء القبول أو الرفض أو طلب الاستكمال."
                               FontSize="12" Foreground="{StaticResource AppMutedInkBrush}" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="280" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- STATE B: Request Selected -->
            <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="20"
                    Visibility="{Binding HasSelectedRequest, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Applicant Name & State -->
                        <DockPanel Margin="0,0,0,14" LastChildFill="True">
                            <Border Width="42" Height="42" CornerRadius="21" Background="#141B524A" DockPanel.Dock="Right" Margin="0,0,12,0">
                                <controls:AppIcon Kind="AccountOutline" Foreground="{StaticResource AppPrimaryBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRequest.Applicant.DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AppInkBrush}" />
                                <TextBlock Text="{Binding SelectedRequest.State}" FontSize="11" Foreground="{StaticResource AppPrimaryBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- Applicant Message Quote Box -->
                        <Border Background="#081B524A" BorderBrush="#1F1B524A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="رسالة المتقدم:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AppPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding SelectedRequest.Message, TargetNullValue='(لا توجد رسالة مرفقة من المتقدم)'}"
                                           FontSize="12" Foreground="{StaticResource AppInkBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Primary Action: Accept Button -->
                        <Button Content="✓ قبول طلب التسجيل" Command="{Binding AcceptCommand}"
                                Style="{StaticResource AppPrimaryButton}"
                                Background="#FF1F7A4D" Foreground="White"
                                Height="42" FontSize="13" FontWeight="Bold"
                                Margin="0,0,0,18" />

                        <Border Height="1" Background="{StaticResource AppBorderBrush}" Margin="0,0,0,16" />

                        <!-- Completion Request Section -->
                        <Border Background="#08F57F17" BorderBrush="#22F57F17" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="طلب استكمال بيانات" FontSize="12" FontWeight="Bold" Foreground="#FFE65100" Margin="0,0,0,8" />
                                <TextBlock Text="الحقول المطلوبة (مفصولة بفواصل)" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RequiredFields, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: الهوية الوطنية، إجازة القرآن" Height="34" Margin="0,0,0,8" />
                                <TextBlock Text="ملاحظة الاستكمال للمتقدم (اختيارية)" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CompletionNote, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" Margin="0,0,0,10" />
                                <Button Content="إرسال طلب الاستكمال" Command="{Binding RequestCompletionCommand}"
                                        Style="{StaticResource AppOutlinedButton}" Height="34" />
                            </StackPanel>
                        </Border>

                        <!-- Rejection Section -->
                        <Border Background="#08D32F2F" BorderBrush="#22D32F2F" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="رفض الطلب" FontSize="12" FontWeight="Bold" Foreground="#FFD32F2F" Margin="0,0,0,8" />
                                <TextBlock Text="سبب الرفض (اختياري)" FontSize="11" Foreground="{StaticResource AppMutedInkBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RejectionNote, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" Margin="0,0,0,10" />
                                <Button Content="تأكيد رفض الطلب" Command="{Binding RejectCommand}"
                                        Style="{StaticResource AppOutlinedButton}" Foreground="#FFD32F2F" BorderBrush="#FFD32F2F" Height="34" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
