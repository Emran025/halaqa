<UserControl x:Class="Halaqa.Desktop.Features.Registrations.Presentation.Views.TeacherApplicationInboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             FlowDirection="RightToLeft">
    <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Button Content="رجوع" Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppOutlinedButton}" />
            <StackPanel>
                <TextBlock Text="طلبات الطلاب المتاحة" Style="{StaticResource PageTitle}" />
                <TextBlock Text="يعرض الصندوق الملخص العام فقط قبل القبول وبدء العلاقة التعليمية." Style="{StaticResource BodyMuted}" />
            </StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" Padding="14" CornerRadius="12" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <WrapPanel DockPanel.Dock="Left">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="بحث بالاسم" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding FilterState}" Width="145" Margin="0,0,8,0" ToolTip="الحالة" />
                    <Button Content="بحث" Command="{Binding ApplyFilterCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,0,8,0" />
                    <ProgressBar Width="72" Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource AppSurfaceBrush}" Padding="12" CornerRadius="12" Margin="0,0,12,0">
                <StackPanel>
                    <ListBox ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest}" MinHeight="280">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12" BorderBrush="#14000000" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Applicant.DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                        <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Content="التالي" Command="{Binding LoadNextPageCommand}" Style="{StaticResource AppOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" Padding="16" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedRequest.Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding SelectedRequest.Applicant.SensitiveFieldsHidden, StringFormat=البيانات الحساسة محجوبة: {0}}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                        <Button Content="قبول" Command="{Binding AcceptCommand}" Margin="0,16,0,0" />
                        <TextBox Text="{Binding RejectionNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="ملاحظة الرفض (اختيارية)" Margin="0,12,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                        <Button Content="رفض" Command="{Binding RejectCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding RequiredFields, UpdateSourceTrigger=PropertyChanged}" ToolTip="حقول الاستكمال، مفصولة بفواصل" Margin="0,16,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                        <TextBox Text="{Binding CompletionNote, UpdateSourceTrigger=PropertyChanged}" ToolTip="ملاحظة الاستكمال (اختيارية)" Margin="0,8,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56" />
                        <Button Content="طلب استكمال" Command="{Binding RequestCompletionCommand}" Style="{StaticResource AppOutlinedButton}" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
