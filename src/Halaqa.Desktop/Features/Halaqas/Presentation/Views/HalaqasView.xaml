<UserControl x:Class="Halaqa.Desktop.Features.Halaqas.Presentation.Views.HalaqasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:shared="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <shared:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource AppCanvasBrush}">
        <Border Style="{StaticResource AppElevatedCard}" MaxWidth="1100" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Command="{Binding BackCommand}" ToolTip="العودة إلى لوحة التحكم">
                        <controls:AppIcon Kind="ArrowRight"  />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="إدارة الحلقات" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="أنشئ حلقاتك وعدّل بياناتها أو فعّلها وأوقفها وفق صلاحيات المعلم." Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Height="112" CornerRadius="4" Margin="0,0,0,14" ClipToBounds="True">
                        <Grid>
                            <Image Source="/Assets/Images/TagAlwaqar/Site/illustrations/hero.jpg" Stretch="UniformToFill" />
                            <Rectangle Fill="#C9143E47" />
                            <StackPanel VerticalAlignment="Center" Margin="20,0">
                                <TextBlock Text="بيئة تعليمية بنَفَس قرآني" Foreground="White" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="نظّم حلقاتك وواصل طريق الإتقان" Foreground="#F5FFFFFF" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#0A000000" CornerRadius="4" Padding="12" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock Text="حلقاتي" Style="{StaticResource SectionTitle}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Total, StringFormat=الإجمالي: {0}}" Style="{StaticResource BodyMuted}" />
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Halaqas}" SelectedItem="{Binding SelectedHalaqa}" Margin="0,12,0,8" BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,3">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" Style="{StaticResource BodyMuted}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Country}" Style="{StaticResource BodyMuted}" />
                                                <TextBlock Text="{Binding StudentCount, StringFormat=الطلاب: {0}}" Style="{StaticResource BodyMuted}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="السابق" Command="{Binding LoadPreviousPageCommand}" />
                                <TextBlock Text="{Binding CurrentPage, StringFormat=الصفحة {0}}" VerticalAlignment="Center" Margin="12,0" />
                                <Button Content="التالي" Command="{Binding LoadNextPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ProgressBar Height="4" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12" />
                            <DockPanel>
                                <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitle}" />
                                <Button DockPanel.Dock="Left" Content="حلقة جديدة" Command="{Binding NewHalaqaCommand}" />
                            </DockPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="اسم الحلقة" />
                                    <TextBlock Text="{Binding NameError}" Style="{StaticResource FieldError}" />
                                    <ComboBox ItemsSource="{Binding GenderOptions}" SelectedValue="{Binding Gender}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" ToolTip="جنس الحلقة" />
                                    <TextBlock Text="{Binding GenderError}" Style="{StaticResource FieldError}" />
                                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="الدولة" />
                                    <TextBlock Text="{Binding CountryError}" Style="{StaticResource FieldError}" />
                                    <TextBox Text="{Binding Residence, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" ToolTip="مقر الحلقة" />
                                    <TextBlock Text="{Binding ResidenceError}" Style="{StaticResource FieldError}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBox Text="{Binding MaxStudents, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="الحد الأقصى للطلاب (اختياري)" />
                                    <TextBlock Text="{Binding MaxStudentsError}" Style="{StaticResource FieldError}" />
                                    <TextBox Text="{Binding Timezone, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" FlowDirection="LeftToRight" ToolTip="المنطقة الزمنية" />
                                    <TextBlock Text="{Binding TimezoneError}" Style="{StaticResource FieldError}" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" AcceptsReturn="True" Height="100" TextWrapping="Wrap" ToolTip="وصف الحلقة (اختياري)" />
                                    <TextBlock Text="{Binding DescriptionError}" Style="{StaticResource FieldError}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                                <Button Content="{Binding SaveTitle}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                                <Button Content="{Binding ToggleStatusTitle}" Command="{Binding ToggleStatusCommand}" Margin="0,0,8,0" />
                                <Button Content="إدارة العضويات" Command="{Binding OpenMembershipsCommand}" Margin="0,0,8,0" />
                                <Button Content="طلبات التسجيل" Command="{Binding OpenRegistrationRequestsCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Button Grid.Row="2" Content="إعادة تحميل الحلقات" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
