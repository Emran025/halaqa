<UserControl x:Class="Halaqa.Desktop.Features.Quran.Presentation.Views.QuranReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Halaqa.Desktop.Shared.Presentation.Controls"
             xmlns:converters="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:QuranPageFontFamilyConverter x:Key="QuranPageFontFamilyConverter" />
    </UserControl.Resources>
    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource AppBackButton}" ToolTip="العودة">
                <controls:AppIcon Kind="ArrowRight" />
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding LoadPreviousPageCommand}" ToolTip="الورقة السابقة"><controls:AppIcon Kind="ChevronRight" /></Button>
                <TextBox Text="{Binding PageNumberInput, UpdateSourceTrigger=PropertyChanged}" Width="66" HorizontalContentAlignment="Center" FlowDirection="LeftToRight" Margin="6,0" ToolTip="رقم الصفحة" />
                <Button Content="انتقال" Command="{Binding LoadPageCommand}" />
                <Button Command="{Binding LoadNextPageCommand}" ToolTip="الورقة التالية" Margin="6,0,0,0"><controls:AppIcon Kind="ChevronLeft" /></Button>
                <ProgressBar Width="72" Height="4" Margin="10,0,0,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFDFBF5" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding QuranPage.PageGlyphText}" FontFamily="{Binding QuranPage, Converter={StaticResource QuranPageFontFamilyConverter}}" FontSize="30" LineHeight="48" TextAlignment="Center" TextWrapping="NoWrap" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#FFB9A47A" />
            <Border Grid.Column="2" Background="#FFFDFBF5" BorderBrush="#22000000" BorderThickness="1" CornerRadius="4" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding FacingPage.PageGlyphText}" FontFamily="{Binding FacingPage, Converter={StaticResource QuranPageFontFamilyConverter}}" FontSize="30" LineHeight="48" TextAlignment="Center" TextWrapping="NoWrap" HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
