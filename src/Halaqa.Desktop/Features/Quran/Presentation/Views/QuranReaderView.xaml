<UserControl x:Class="Halaqa.Desktop.Features.Quran.Presentation.Views.QuranReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Halaqa.Desktop.Shared.Presentation.Converters"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:QuranPageFontFamilyConverter x:Key="QuranPageFontFamilyConverter" />
    </UserControl.Resources>
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button Content="رجوع" Command="{Binding BackCommand}" DockPanel.Dock="Left" Style="{StaticResource MaterialDesignOutlinedButton}" />
            <StackPanel>
                <TextBlock Text="قارئ المصحف" Style="{StaticResource PageTitle}" />
                <TextBlock Text="قراءة مستقلة محلية أولاً؛ لا تحفظ حالة جلسة ولا تشارك موضعاً مع أي طرف." Style="{StaticResource BodyMuted}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource AppSurfaceBrush}" Padding="14" CornerRadius="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding QuranSourceLabel}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource BodyMuted}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadPreviousPageCommand}" ToolTip="الصفحة السابقة"><materialDesign:PackIcon Kind="ChevronRight" /></Button>
                    <TextBox Text="{Binding PageNumberInput, UpdateSourceTrigger=PropertyChanged}" Width="66" HorizontalContentAlignment="Center" FlowDirection="LeftToRight" Margin="6,0" materialDesign:HintAssist.Hint="صفحة" />
                    <Button Content="انتقال" Command="{Binding LoadPageCommand}" />
                    <Button Command="{Binding LoadNextPageCommand}" ToolTip="الصفحة التالية" Margin="6,0,0,0"><materialDesign:PackIcon Kind="ChevronLeft" /></Button>
                    <ProgressBar Width="72" Height="4" Margin="10,0,0,0" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Border Background="#FFFDFBF5" BorderBrush="#14000000" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding QuranPage.PageGlyphText}"
                               FontFamily="{Binding QuranPage.PageNumber, Converter={StaticResource QuranPageFontFamilyConverter}}"
                               FontSize="34"
                               LineHeight="54"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType" />
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" Padding="12" CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="آيات الصفحة" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding QuranPage.Ayahs}" SelectedItem="{Binding SelectedAyah}" Margin="0,10,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Number, StringFormat=آية {0}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
